---
// GitHub icon link + Thema picker.
import ThemaPicker, { type ThemaItem } from './ThemaPicker.astro';
import { site } from '../../site';

interface Props {
	thema: {
		items: ThemaItem[];
		storageKey: string;
		attr: string;
		modes?: Record<string, 'dark' | 'light'>;
	};
	align?: 'left' | 'right';
	placement?: 'down' | 'up';
}
const { thema, align = 'right', placement = 'down' } = Astro.props;
---

<div class="nav-tools">
	<a class="gh" href={site.github} target="_blank" rel="noopener" aria-label="GitHub">
		<svg viewBox="0 0 16 16" aria-hidden="true">
			<path
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
	</a>
	<ThemaPicker {...thema} align={align} placement={placement} />
</div>

<style>
	.nav-tools {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}
	.gh {
		display: inline-grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		border: 1px solid var(--line-2, var(--sl-color-hairline-light));
		border-radius: 50%;
		color: var(--fg-2, var(--sl-color-gray-2));
		transition:
			color 140ms,
			border-color 140ms,
			transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.gh:hover {
		color: var(--fg, var(--sl-color-white));
		border-color: var(--accent, var(--sl-color-accent));
		transform: rotate(-8deg);
	}
	.gh svg {
		width: 1rem;
		height: 1rem;
		fill: currentColor;
	}
</style>
