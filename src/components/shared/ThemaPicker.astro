---
// "Thema" button + small sliding card list (Max Böck–style). Used by the Portfolio (themes) and Notes (palettes).
export interface ThemaItem {
	id: string;
	label: string;
	bg: string;
	fg: string;
	font?: string;
	swatches: string[];
}

interface Props {
	items: ThemaItem[];
	/** localStorage key */
	storageKey: string;
	/** data-* attribute set on <html>, e.g. 'ptheme' -> data-ptheme */
	attr: string;
	/** optional id -> 'dark' | 'light', mirrored to <html data-theme> (Starlight) */
	modes?: Record<string, 'dark' | 'light'>;
	/** which edge of the button the panel aligns to */
	align?: 'left' | 'right';
	/** 'up' opens above the button (e.g. mobile menu footer) */
	placement?: 'down' | 'up';
}

const { items, storageKey, attr, modes, align = 'right', placement = 'down' } = Astro.props;
const panelId = `thema-${attr}-${Math.random().toString(36).slice(2, 7)}`;
---

<thema-picker data-attr={attr} data-key={storageKey} data-modes={JSON.stringify(modes ?? {})} data-align={align} data-placement={placement}>
	<button type="button" class="thema-btn" aria-expanded="false" aria-controls={panelId} aria-haspopup="true">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<rect x="3" y="3" width="15" height="6" rx="1.5"></rect>
			<path d="M18 6h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-8v3"></path>
			<rect x="10.5" y="14" width="3" height="7" rx="1"></rect>
		</svg>
		<span>Thema</span>
	</button>
	<div class="thema-panel" id={panelId} role="dialog" aria-label="Thema" hidden>
		<p class="thema-title">Select Thema</p>
		<ul class="thema-list" role="listbox" aria-label="Thema">
			{
				items.map((t) => (
					<li>
						<button
							type="button"
							role="option"
							aria-selected="false"
							data-id={t.id}
							style={`--c-bg:${t.bg};--c-fg:${t.fg};--c-font:${t.font ?? 'inherit'}`}
						>
							<span class="name">{t.label}</span>
							<span class="dots" aria-hidden="true">
								{t.swatches.map((c) => (
									<i style={`background:${c}`} />
								))}
							</span>
						</button>
					</li>
				))
			}
		</ul>
	</div>
</thema-picker>

<script>
	class ThemaPicker extends HTMLElement {
		#btn!: HTMLButtonElement;
		#panel!: HTMLElement;
		#options: HTMLButtonElement[] = [];
		#onDoc = (e: Event) => {
			if (!this.contains(e.target as Node)) this.close();
		};

		connectedCallback() {
			this.#btn = this.querySelector('.thema-btn')!;
			this.#panel = this.querySelector('.thema-panel')!;
			this.#options = [...this.querySelectorAll<HTMLButtonElement>('[role="option"]')];
			this.sync();
			this.#btn.addEventListener('click', () => (this.#panel.hidden ? this.open() : this.close()));
			this.#options.forEach((o) => o.addEventListener('click', () => this.apply(o.dataset.id!)));
			this.addEventListener('keydown', (e) => this.#onKey(e));
		}

		get attr() {
			return this.dataset.attr!;
		}

		sync() {
			const cur = document.documentElement.dataset[this.attr];
			this.#options.forEach((o) => o.setAttribute('aria-selected', String(o.dataset.id === cur)));
		}

		apply(id: string) {
			const root = document.documentElement;
			const modes: Record<string, string> = JSON.parse(this.dataset.modes || '{}');
			root.dataset[this.attr] = id;
			if (modes[id]) root.dataset.theme = modes[id];
			try {
				localStorage.setItem(this.dataset.key!, id);
			} catch {}
			document.querySelectorAll<ThemaPicker>('thema-picker').forEach((p) => p.sync());
			document.dispatchEvent(new CustomEvent('thema-change', { detail: { attr: this.attr, id } }));
		}

		open() {
			this.#panel.hidden = false;
			this.#btn.setAttribute('aria-expanded', 'true');
			requestAnimationFrame(() => this.#panel.classList.add('open'));
			const selected = this.#options.find((o) => o.getAttribute('aria-selected') === 'true') ?? this.#options[0];
			selected?.scrollIntoView({ block: 'nearest', inline: 'center' });
			selected?.focus({ preventScroll: true });
			document.addEventListener('pointerdown', this.#onDoc);
		}

		close(focusButton = false) {
			if (this.#panel.hidden) return;
			this.#panel.classList.remove('open');
			this.#panel.hidden = true;
			this.#btn.setAttribute('aria-expanded', 'false');
			document.removeEventListener('pointerdown', this.#onDoc);
			if (focusButton) this.#btn.focus();
		}

		#onKey(e: KeyboardEvent) {
			if (e.key === 'Escape') return this.close(true);
			const i = this.#options.indexOf(document.activeElement as HTMLButtonElement);
			if (i === -1) return;
			const step = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
			if (!step) return;
			e.preventDefault();
			const next = this.#options[(i + step + this.#options.length) % this.#options.length];
			next.focus();
			next.scrollIntoView({ block: 'nearest', inline: 'nearest' });
		}
	}
	if (!customElements.get('thema-picker')) customElements.define('thema-picker', ThemaPicker);
</script>

<style>
	thema-picker {
		--tp-surface: var(--bg-2, var(--sl-color-bg-nav));
		--tp-line: var(--line-2, var(--sl-color-hairline-light));
		--tp-fg: var(--fg, var(--sl-color-white));
		--tp-fg-2: var(--fg-2, var(--sl-color-gray-2));
		--tp-fg-3: var(--fg-3, var(--sl-color-gray-3));
		--tp-accent: var(--accent, var(--sl-color-accent));
		--tp-mono: var(--mono, var(--sl-font-mono));
		position: relative;
		display: inline-block;
	}
	.thema-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		height: 2.25rem;
		padding: 0 0.8rem 0 0.7rem;
		border: 2px solid var(--tp-line);
		border-radius: 999px;
		background: transparent;
		color: var(--tp-fg-2);
		font-family: var(--tp-mono);
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		cursor: pointer;
		transition:
			color 140ms,
			border-color 140ms;
	}
	.thema-btn:hover,
	.thema-btn[aria-expanded='true'] {
		color: var(--tp-fg);
		border-color: var(--tp-accent);
	}
	.thema-btn svg {
		width: 1rem;
		height: 1rem;
		transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	.thema-btn:hover svg {
		transform: rotate(-12deg) translateY(-1px);
	}

	.thema-panel {
		position: absolute;
		top: calc(100% + 0.6rem);
		right: 0;
		z-index: 100;
		width: min(34rem, calc(100vw - 2rem));
		padding: 0.85rem 0.85rem 0.5rem;
		border: 1px solid var(--tp-line);
		border-radius: 14px;
		background: var(--tp-surface);
		box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.45);
		opacity: 0;
		translate: 0 -6px;
		transition:
			opacity 180ms ease,
			translate 240ms cubic-bezier(0.16, 1, 0.3, 1);
	}
	thema-picker[data-align='left'] .thema-panel {
		right: auto;
		left: 0;
	}
	thema-picker[data-placement='up'] .thema-panel {
		top: auto;
		bottom: calc(100% + 0.6rem);
		translate: 0 6px;
	}
	.thema-panel:global(.open) {
		opacity: 1;
		translate: 0 0;
	}
	.thema-title {
		margin: 0 0 0.6rem;
		font-family: var(--tp-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		text-align: center;
		color: var(--tp-fg-3);
	}
	.thema-list {
		list-style: none;
		margin: 0;
		padding: 0.15rem 0.15rem 1.1rem;
		display: flex;
		gap: 0.6rem;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		scrollbar-width: thin;
	}
	.thema-list li {
		scroll-snap-align: center;
		flex: none;
	}
	[role='option'] {
		position: relative;
		display: grid;
		justify-items: center;
		gap: 0.5rem;
		width: 8.5rem;
		padding: 0.8rem 0.6rem 0.75rem;
		border: 2px solid transparent;
		border-radius: 10px;
		background: var(--c-bg);
		color: var(--c-fg);
		box-shadow: inset 0 0 0 1px rgb(127 127 127 / 0.25);
		cursor: pointer;
		transition:
			transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
			border-color 140ms;
	}
	[role='option']:hover {
		transform: translateY(-2px);
	}
	[role='option'][aria-selected='true'] {
		border-color: var(--tp-accent);
	}
	[role='option'][aria-selected='true']::after {
		content: '';
		position: absolute;
		left: 50%;
		bottom: -0.95rem;
		translate: -50% 0;
		border: 0.4rem solid transparent;
		border-bottom-color: var(--tp-accent);
	}
	[role='option']:focus-visible {
		outline: 2px solid var(--tp-accent);
		outline-offset: 2px;
	}
	.name {
		font-family: var(--c-font);
		font-size: 0.95rem;
		line-height: 1.2;
		white-space: nowrap;
	}
	.dots {
		display: flex;
	}
	.dots i {
		width: 1.25rem;
		height: 1.25rem;
		border-radius: 50%;
		border: 2px solid var(--c-bg);
		margin-left: -0.35rem;
	}
	.dots i:first-child {
		margin-left: 0;
	}
	@media (prefers-reduced-motion: reduce) {
		.thema-panel,
		[role='option'] {
			transition: none;
		}
	}
</style>
