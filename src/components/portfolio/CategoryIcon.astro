---
// Pictograms for the work types (src/portfolio/categories.ts), drawn in currentColor from graphics primitives.
import type { CategoryId } from '../../portfolio/categories';

interface Props {
	id: CategoryId | 'all';
	class?: string;
}

const { id, class: className } = Astro.props;
---

<svg class:list={['cat-icon', className]} viewBox="0 0 24 24" aria-hidden="true">
	{
		/* four sample points */
		id === 'all' && (
			<>
				<circle class="dot" cx="7" cy="7" r="1.9" />
				<circle class="dot" cx="17" cy="7" r="1.9" />
				<circle class="dot" cx="7" cy="17" r="1.9" />
				<circle class="dot" cx="17" cy="17" r="1.9" />
			</>
		)
	}
	{
		/* a lit sphere: the shadow side filled past the terminator */
		id === 'shader' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<path class="dot" d="M12 4a8 8 0 0 1 0 16a4.5 8 0 0 0 0-16Z" />
			</>
		)
	}
	{
		/* a wireframe cube */
		id === 'render' && <path d="M12 3.5 19.5 7.75v8.5L12 20.5 4.5 16.25v-8.5ZM4.5 7.75 12 12 19.5 7.75M12 12v8.5" />
	}
	{
		/* two parameter sliders */
		id === 'tool' && (
			<>
				<path d="M4 8h16M4 16h16" />
				<circle class="knob" cx="9" cy="8" r="2.3" />
				<circle class="knob" cx="15" cy="16" r="2.3" />
			</>
		)
	}
</svg>

<style>
	.cat-icon {
		width: 1.25rem;
		height: 1.25rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linejoin: miter;
		flex: none;
	}
	.cat-icon .dot {
		fill: currentColor;
		stroke: none;
	}
	/* the knob hides the track behind it */
	.cat-icon .knob {
		fill: var(--bg);
	}
</style>
