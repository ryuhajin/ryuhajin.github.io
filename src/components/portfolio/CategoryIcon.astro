---
// Line pictograms for the work types (src/portfolio/categories.ts), drawn in currentColor.
import type { CategoryId } from '../../portfolio/categories';

interface Props {
	id: CategoryId | 'all';
	class?: string;
}

const { id, class: className } = Astro.props;
---

<svg class:list={['cat-icon', className]} viewBox="0 0 24 24" aria-hidden="true">
	{
		id === 'all' && (
			<>
				<rect x="4" y="4" width="6.5" height="6.5" />
				<rect x="13.5" y="4" width="6.5" height="6.5" />
				<rect x="4" y="13.5" width="6.5" height="6.5" />
				<rect x="13.5" y="13.5" width="6.5" height="6.5" />
			</>
		)
	}
	{
		/* a toon-shaded sphere: light bands as rings pulled toward the light (upper right), and the highlight */
		id === 'shader' && (
			<>
				<circle cx="12" cy="12" r="8" />
				<circle cx="13.6" cy="10.4" r="5.4" />
				<circle cx="15" cy="9" r="2.9" />
				<circle class="dot" cx="15.6" cy="8.4" r="0.9" />
			</>
		)
	}
	{
		/* one mesh triangle with its three vertices */
		id === 'render' && (
			<>
				<path d="M5 8 19.5 6.5 10.5 19Z" />
				<circle class="dot" cx="5" cy="8" r="1.7" />
				<circle class="dot" cx="19.5" cy="6.5" r="1.7" />
				<circle class="dot" cx="10.5" cy="19" r="1.7" />
			</>
		)
	}
	{
		/* an open-end wrench lying on the diagonal, jaw to the upper right */
		id === 'tool' && <path d="M19.88 6.39A4.2 4.2 0 0 1 14.19 11.79L6.49 19.49A1.4 1.4 0 0 1 4.51 17.51L12.21 9.81A4.2 4.2 0 0 1 17.62 4.12L15.58 6.16 17.84 8.42Z" />
	}
</svg>

<style>
	.cat-icon {
		width: 1.5rem;
		height: 1.5rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.3;
		stroke-linejoin: miter;
		flex: none;
	}
	.cat-icon rect {
		fill: var(--icon-fill, none);
	}
	.cat-icon .dot {
		fill: currentColor;
		stroke: none;
	}
</style>
