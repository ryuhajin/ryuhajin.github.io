---
// Progress viewer.
//   slider=false: step tabs that cross-fade between captures (different framings are fine).
//   slider=true : the last step is "after"; the tab picks the "before" layer, and a draggable divider
//                 (a range input, so arrows / Home / End work) reveals one over the other. Needs aligned captures.
interface Step {
	src: string;
	label?: string;
	note?: string;
}
interface Props {
	steps: Step[];
	slider?: boolean;
}
const { steps, slider = false } = Astro.props;
const after = steps[steps.length - 1];
const befores = slider ? steps.slice(0, -1) : steps;
const showSteps = befores.length > 1;
---

<div class:list={['cmp', { 'is-slider': slider }]} data-compare style="--pos: 50%">
	<div class="stage">
		{slider && <img class="after" src={after.src} alt={after.label ?? ''} loading="lazy" decoding="async" />}
		{
			befores.map((s, i) => (
				<img class:list={['layer', { on: i === 0 }]} src={s.src} alt={s.label ?? ''} loading="lazy" decoding="async" data-step={i} data-note={s.note} />
			))
		}
		{
			slider && (
				<>
					<span class="tag tag-b" data-before-label>{befores[0].label}</span>
					<span class="tag tag-a">{after.label}</span>
					<span class="divider" aria-hidden="true">
						<svg class="grip" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="m9 6-6 6 6 6M15 6l6 6-6 6" />
						</svg>
					</span>
					<input class="range" type="range" min="0" max="100" value="50" aria-label="비교 위치 (왼쪽: 이전, 오른쪽: 이후)" />
				</>
			)
		}
	</div>
	<div class="steps" hidden={!showSteps} role="tablist" aria-label={slider ? '비교할 이전 단계' : '단계'}>
		{
			befores.map((s, i) => (
				<button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-go={i}>
					<span class="mono n">{String(i + 1).padStart(2, '0')}</span>
					<span class="l">{s.label}</span>
				</button>
			))
		}
	</div>
	{showSteps || befores[0].note ? <p class="step-note" data-step-note aria-live="polite">{befores[0].note}</p> : null}
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-compare]').forEach((root) => {
		const layers = [...root.querySelectorAll<HTMLImageElement>('.layer')];
		const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
		const note = root.querySelector<HTMLElement>('[data-step-note]');
		const beforeLabel = root.querySelector<HTMLElement>('[data-before-label]');
		const select = (i: number) => {
			layers.forEach((l, j) => l.classList.toggle('on', j === i));
			tabs.forEach((t, j) => t.setAttribute('aria-selected', String(j === i)));
			const label = tabs[i].querySelector('.l')?.textContent ?? '';
			if (beforeLabel) beforeLabel.textContent = label;
			if (note) note.textContent = layers[i].dataset.note ?? '';
		};
		tabs.forEach((t, i) => {
			t.addEventListener('click', () => select(i));
			t.addEventListener('keydown', (e) => {
				const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (!d) return;
				e.preventDefault();
				const n = (i + d + tabs.length) % tabs.length;
				tabs[n].focus();
				select(n);
			});
		});
		const range = root.querySelector<HTMLInputElement>('.range');
		range?.addEventListener('input', () => root.style.setProperty('--pos', `${range.value}%`));
	});
</script>

<style>
	.cmp {
		display: grid;
		gap: 0.9rem;
	}
	.stage {
		position: relative;
		aspect-ratio: 16 / 9;
		max-height: 58vh;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--line-2);
		background: var(--bg-3);
	}
	.stage img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.layer {
		opacity: 0;
		transition: opacity 420ms var(--ease);
	}
	.layer.on {
		opacity: 1;
	}
	.is-slider .layer {
		clip-path: inset(0 calc(100% - var(--pos)) 0 0);
	}
	.divider {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--pos);
		width: 1px;
		background: #fffd;
		box-shadow: 0 0 10px #0006;
		pointer-events: none;
	}
	.grip {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		box-sizing: content-box;
		padding: 0.55rem;
		border-radius: 50%;
		background: #0b0b0e99;
		border: 1px solid #fff4;
		color: #fff;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		box-shadow: 0 4px 16px #0005;
	}
	.range {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		margin: 0;
		opacity: 0;
		cursor: ew-resize;
	}
	.stage:has(.range:focus-visible) .grip {
		border-color: var(--accent);
	}
	/* labels sit on the picture: frosted pill, UI font */
	.tag {
		position: absolute;
		top: 0.75rem;
		z-index: 1;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		background: #0b0b0e80;
		border: 1px solid #fff2;
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		color: #fff;
		font-family: var(--font-ui, var(--sans));
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		line-height: 1.4;
		pointer-events: none;
	}
	.tag-b {
		left: 0.75rem;
	}
	.tag-a {
		right: 0.75rem;
	}
	.steps[hidden] {
		display: none;
	}
	.steps {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.steps button {
		all: unset;
		cursor: pointer;
		display: inline-flex;
		gap: 0.5rem;
		align-items: baseline;
		padding: 0.4rem 0.75rem;
		border: 1px solid var(--line-2);
		border-radius: 999px;
		font-size: 0.8rem;
		color: var(--fg-2);
		transition:
			color var(--t-micro),
			background-color var(--t-micro),
			border-color var(--t-micro);
	}
	.steps button:hover {
		color: var(--fg);
		border-color: var(--fg-3);
	}
	.steps button[aria-selected='true'] {
		background: var(--fg);
		border-color: var(--fg);
		color: var(--bg);
	}
	.steps button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.n {
		opacity: 0.6;
	}
	.step-note {
		margin: 0;
		min-height: 1.5em;
		color: var(--fg-2);
		font-size: 0.875rem;
		line-height: 1.6;
	}
</style>
