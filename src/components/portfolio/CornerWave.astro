---
// Top band: a real black & white shoreline (aerial footage, 8s seamless loop — public/wave/, see CREDITS.md),
// tilted so the foam line runs diagonally from the upper middle of the page down to the right edge.
// The video only starts loading once the page is idle; reduced-motion shows the still poster.
---

<div class="top-wave" aria-hidden="true">
	<video class="shore" data-src="/wave/shore.mp4" poster="/wave/shore.jpg" muted loop playsinline preload="none"></video>
</div>

<script>
	const video = document.querySelector<HTMLVideoElement>('.top-wave video');
	if (video && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const play = () => video.play().catch(() => {});
		const start = () => {
			video.src = video.dataset.src!;
			play();
		};
		// browsers pause background tabs; resume when the page is visible again
		document.addEventListener('visibilitychange', () => document.visibilityState === 'visible' && video.src && play());
		if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
		else setTimeout(start, 300);
	}
</script>

<style>
	.top-wave {
		position: absolute;
		top: 0;
		right: 0;
		/* only a sliver of surf peeks in along the top-right */
		width: 68vw;
		height: min(24vh, 15vw);
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
		/* fade in from the left so the band starts around the upper middle of the page */
		mask-image: linear-gradient(to right, transparent 0%, #000 30%);
	}
	.shore {
		position: absolute;
		left: 56%;
		top: -8%;
		width: 118%;
		height: auto;
		aspect-ratio: 960 / 400;
		max-width: none;
		object-fit: cover;
		translate: -50% -50%;
		/* sea up top, foam line tilted down toward the right edge */
		rotate: 12deg;
		filter: grayscale(1) contrast(1.15);
		/* the sand side fades into the page */
		mask-image: linear-gradient(to bottom, #000 46%, transparent 72%);
	}
	/* dark themes: black sand melts into the page, only water + white foam remain */
	:global(:root:is([data-ptheme='mono'], [data-ptheme='space'], [data-ptheme='violet'])) .shore {
		mix-blend-mode: screen;
	}
	:global(:root:is([data-ptheme='paper'], [data-ptheme='candy'])) .top-wave {
		opacity: 0.9;
	}
	/* 8-bit: tint it to the Game Boy greens */
	:global(:root[data-ptheme='gameboy']) .shore {
		filter: grayscale(1) contrast(1.4) sepia(1) hue-rotate(40deg) saturate(2.2) brightness(0.8);
	}
	@media (max-width: 720px) {
		.top-wave {
			width: 100vw;
			height: 16vh;
		}
	}
</style>
