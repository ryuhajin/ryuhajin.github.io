---
// Click-to-load YouTube: a poster + play button until the visitor asks for the video, so the page itself makes no
// request to YouTube. The player comes from youtube-nocookie.com.
interface Props {
	id: string;
	poster: string;
	title: string;
}
const { id, poster, title } = Astro.props;
---

<div class="yt" data-yt={id} data-title={title}>
	<img src={poster} alt="" loading="lazy" decoding="async" />
	<button type="button" class="play" aria-label={`${title} 영상 재생 (YouTube)`}>
		<span class="disc">
			<!-- centroid at x 12.3: a hair right of the circle centre, where a triangle looks centred -->
			<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.3 6.8v10.4l9-5.2z"></path></svg>
		</span>
	</button>
	<a class="out" href={`https://youtu.be/${id}`} target="_blank" rel="noopener">YouTube에서 보기 ↗</a>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
		box.querySelector('.play')?.addEventListener('click', () => {
			const frame = document.createElement('iframe');
			frame.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
			frame.title = box.dataset.title ?? 'YouTube video';
			frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
			frame.allowFullscreen = true;
			box.replaceChildren(frame);
			box.classList.add('is-playing');
		});
	});
</script>

<style>
	.yt {
		position: relative;
		aspect-ratio: 16 / 9;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid var(--line-2);
		background: #000;
	}
	.yt img,
	.yt :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}
	.yt img {
		opacity: 0.72;
		transition:
			opacity var(--t-fast) var(--ease),
			scale 600ms var(--ease-out);
	}
	.yt:hover img {
		opacity: 0.9;
		scale: 1.02;
	}
	.play {
		all: unset;
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		cursor: pointer;
	}
	/* frosted glass disc; turns solid white with a dark triangle on hover */
	.disc {
		display: grid;
		place-items: center;
		width: 4.25rem;
		aspect-ratio: 1;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.16);
		border: 1px solid rgb(255 255 255 / 0.38);
		backdrop-filter: blur(10px) saturate(1.4);
		-webkit-backdrop-filter: blur(10px) saturate(1.4);
		box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
		transition:
			background var(--t-fast) var(--ease),
			border-color var(--t-fast) var(--ease),
			scale var(--t-fast) var(--ease-out);
	}
	.disc svg {
		width: 1.75rem;
		height: 1.75rem;
		fill: #fff;
		/* the stroke rounds the corners without moving the centroid */
		stroke: #fff;
		stroke-width: 1.6;
		stroke-linejoin: round;
		transition:
			fill var(--t-fast) var(--ease),
			stroke var(--t-fast) var(--ease);
	}
	.play:hover .disc,
	.play:focus-visible .disc {
		background: #fff;
		border-color: #fff;
		scale: 1.06;
	}
	.play:hover .disc svg,
	.play:focus-visible .disc svg {
		fill: #0b0b0d;
		stroke: #0b0b0d;
	}
	.play:focus-visible .disc {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	.out {
		position: absolute;
		right: 0.9rem;
		bottom: 0.75rem;
		color: #fff;
		/* Pretendard, not the mono face: the mono font has no Hangul, so "에서 보기" fell back to a thin system font */
		font-family: var(--sans);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-shadow: 0 1px 6px #000;
	}
</style>
