---
import Caption from './Caption.astro';
// Width wrapper for blocks that have no size of their own (YouTube, Compare, Flipbooks, PresetCards).
interface Props {
	size?: 'text' | 'wide' | 'full';
	caption?: string;
}
const { size = 'wide', caption } = Astro.props;
---

<figure class:list={['block', size]}>
	<slot />
	{caption && <Caption text={caption} />}
</figure>

<style>
	.block {
		margin: 0;
		display: grid;
		gap: 0.6rem;
	}
</style>
