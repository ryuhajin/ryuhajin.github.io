---
import Caption from './Caption.astro';
import { imageSize } from '../../../portfolio/image-size';
import '../../../styles/media.css';
// One image (opens in the page lightbox) or a looping clip, with a short caption (Caption.astro).
// size: 'text' stays in the reading column, 'wide' / 'full' break out of it (see .prose in projects/[slug].astro).
// Inside <Grid> the size is ignored and the figure fills its cell.
// Clips load and play only near the viewport (scripts/portfolio/clips.ts); width/height come from the poster or image file.
// Zoom tag and play button: styles/media.css (shared with devlog/story/Shot).
interface Props {
	src: string;
	caption?: string;
	alt?: string;
	/** webm / mp4 clip; `src` is then its poster */
	video?: string;
	size?: 'text' | 'wide' | 'full';
}
const { src, caption, alt, video, size = 'text' } = Astro.props;
const dims = await imageSize(src);
---

<figure class:list={['fig', size]}>
	{
		video ? (
			<div class="media-clip">
				<video data-src={video} poster={src} {...dims} muted loop playsinline preload="none" data-lazy-clip aria-label={alt ?? caption} />
				<button type="button" class="media-play" data-clip-play aria-label={`${alt ?? caption ?? '영상'} 재생`}>▶ 영상 재생</button>
			</div>
		) : (
			<button type="button" class="media-zoom" data-lightbox={src} data-caption={caption} aria-label="크게 보기">
				<img src={src} {...dims} alt={alt ?? caption ?? ''} loading="lazy" decoding="async" />
				<span class="media-tag" aria-hidden="true">
					<svg viewBox="0 0 24 24"><path d="M14 4h6v6M10 20H4v-6M20 4l-6.5 6.5M4 20l6.5-6.5" /></svg>
					크게 보기
				</span>
			</button>
		)
	}
	{caption && <Caption text={caption} />}
</figure>

<script>
	import '../../../scripts/portfolio/clips';
</script>

<style>
	.fig {
		margin: 0;
		display: grid;
		gap: 0.6rem;
		align-content: start;
	}
	img,
	video {
		display: block;
		width: 100%;
		height: auto;
		background: var(--bg-3);
	}
</style>
