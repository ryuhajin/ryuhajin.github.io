---
import Caption from './Caption.astro';
// One image (opens in the page lightbox) or a looping clip, with a short caption (Caption.astro).
// size: 'text' stays in the reading column, 'wide' / 'full' break out of it (see .prose in projects/[slug].astro).
// Inside <Grid> the size is ignored and the figure fills its cell.
interface Props {
	src: string;
	caption?: string;
	alt?: string;
	/** webm / mp4 clip; `src` is then its poster */
	video?: string;
	size?: 'text' | 'wide' | 'full';
}
const { src, caption, alt, video, size = 'text' } = Astro.props;
---

<figure class:list={['fig', size]}>
	{
		video ? (
			<video src={video} poster={src} muted loop playsinline autoplay preload="metadata" aria-label={alt ?? caption} />
		) : (
			<button type="button" class="shot" data-cursor="zoom" data-lightbox={src} data-caption={caption}>
				<img src={src} alt={alt ?? caption ?? ''} loading="lazy" decoding="async" />
			</button>
		)
	}
	{caption && <Caption text={caption} />}
</figure>

<style>
	.fig {
		margin: 0;
		display: grid;
		gap: 0.6rem;
		align-content: start;
	}
	.shot {
		all: unset;
		display: block;
		overflow: hidden;
		border-radius: 6px;
		background: var(--bg-3);
		cursor: zoom-in;
	}
	@media (hover: hover) and (pointer: fine) {
		.shot {
			cursor: none;
		}
	}
	.shot:focus-visible {
		outline: 2px solid var(--accent-p, var(--accent));
		outline-offset: 2px;
	}
	img,
	video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 6px;
	}
	img {
		transition: scale 600ms var(--ease-out);
	}
	.shot:hover img {
		scale: 1.03;
	}
</style>
