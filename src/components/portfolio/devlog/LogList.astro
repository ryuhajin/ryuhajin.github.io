---
// Devlog rows (#NN | title | date) in the Projects list-view rule language. Each row is a page item for the
// block's pager (src/scripts/portfolio/pager.ts); the closing rule sits on the block, so paging never loses it.
import { entryUrl, fmtDate, pad, type Devlog } from '../../../portfolio/devlog';

interface Props {
	entries: Devlog[];
	/** project cover, used for the hover preview when an entry has no picture */
	fallback: string;
	accent: string;
}

const { entries, fallback, accent } = Astro.props;
---

<ol class="loglist">
	{
		entries.map((e) => (
			<li data-page-item>
				<a href={entryUrl(e)} class="row" data-media-src={e.data.images[0]?.src ?? fallback} data-accent={accent}>
					<span class="no">#{pad(e.data.part)}</span>
					<span class="t">{e.data.title}</span>
					<span class="mono date">{fmtDate(e.data.date)}</span>
				</a>
			</li>
		))
	}
</ol>

<style>
	ol {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li[hidden] {
		display: none;
	}
	/* sizes and the meta colour come from the page (devlog/index.astro: --no-w, --row-t, --meta) */
	.row {
		display: grid;
		grid-template-columns: var(--no-w, 4.5rem) minmax(0, 1fr) 6.5rem;
		align-items: baseline;
		gap: 1rem;
		padding: clamp(0.75rem, 1.7vh, 1rem) 0.25rem;
		border-top: 2px solid var(--line-2);
		transition:
			border-color var(--t-fast) var(--ease),
			padding var(--t-fast) var(--ease-out);
	}
	.row > * {
		transition: opacity var(--t-fast) var(--ease);
	}
	/* dim the other rows' text only — the rules stay, so the hovered row keeps its line */
	ol:has(.row:hover) .row:not(:hover) > * {
		opacity: 0.3;
	}
	.row:hover,
	li:has(.row:hover) + li .row {
		border-top-color: var(--fg);
	}
	.row:hover {
		padding-inline: 1.25rem 0.25rem;
	}
	/* the part number reads a step under the title size; the date stays small; both share one colour */
	.no {
		font-family: var(--meta-font, var(--sans));
		font-size: calc(var(--row-t, 1.375rem) * 0.8);
		font-variant-numeric: tabular-nums;
		color: var(--meta, var(--fg-3));
	}
	.t {
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: var(--row-t, 1.375rem);
		line-height: 1.3;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.date {
		font-family: var(--meta-font, var(--sans));
		font-size: 0.8125rem;
		font-variant-numeric: tabular-nums;
		color: var(--meta, var(--fg-3));
		text-align: right;
	}

	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		.row {
			grid-template-columns: var(--no-w, 3.25rem) minmax(0, 1fr);
			gap: 0.2rem 0.75rem;
			min-height: 44px;
		}
		.t {
			white-space: normal;
			overflow-wrap: anywhere;
		}
		.date {
			grid-column: 2;
			text-align: left;
			white-space: normal;
		}
		ol:has(.row:hover) .row:not(:hover) > * {
			opacity: 1;
		}
		.row:hover {
			padding-inline: 0.25rem;
		}
	}
</style>
