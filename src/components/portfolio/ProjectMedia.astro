---
// Poster image + optional motion (webm/mp4). Video is not downloaded until hover (data-src) unless `autoplay`.
interface Props {
	poster: string;
	video?: string;
	alt: string;
	autoplay?: boolean;
	class?: string;
	eager?: boolean;
}

// `...rest` forwards transition:name (compiled to data-astro-transition-* attributes) to the root element.
const { poster, video, alt, autoplay = false, class: className, eager = false, ...rest } = Astro.props;
const isVideo = video && /\.(webm|mp4)$/i.test(video);
const motionImage = video && !isVideo ? video : undefined; // gif / animated svg
---

<div class:list={['pm', className]} {...rest}>
	<img src={motionImage ?? poster} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
	{
		isVideo &&
			(autoplay ? (
				<video src={video} poster={poster} muted loop playsinline autoplay preload="metadata" aria-hidden="true" />
			) : (
				<video data-src={video} poster={poster} muted loop playsinline preload="none" data-hover-play aria-hidden="true" />
			))
	}
</div>

<style>
	.pm {
		position: relative;
		overflow: hidden;
		background: var(--bg-3);
	}
	.pm img,
	.pm video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.pm video[data-hover-play] {
		opacity: 0;
		transition: opacity var(--t-fast) var(--ease);
	}
	:global([data-hover-card]:hover) .pm video[data-hover-play],
	:global([data-hover-card]:focus-visible) .pm video[data-hover-play] {
		opacity: 1;
	}
</style>
