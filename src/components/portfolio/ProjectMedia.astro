---
// Poster image + optional motion (webm/mp4). Video is not downloaded until hover (data-src) unless `autoplay`.
interface Props {
	poster: string;
	video?: string;
	alt: string;
	autoplay?: boolean;
	class?: string;
	eager?: boolean;
	/** view-transition-name for the shared-element morph between list and detail */
	vtName?: string;
}

const { poster, video, alt, autoplay = false, class: className, eager = false, vtName } = Astro.props;
const isVideo = video && /\.(webm|mp4)$/i.test(video);
const motionImage = video && !isVideo ? video : undefined; // gif / animated svg
---

<div class:list={['pm', className]} style={vtName ? `view-transition-name: ${vtName}` : undefined}>
	<img src={poster} data-motion-src={motionImage} data-poster={motionImage ? poster : undefined} alt={alt} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
	{
		isVideo &&
			(autoplay ? (
				<video data-src={video} poster={poster} muted loop playsinline preload="none" data-decorative-clip aria-hidden="true" hidden />
			) : (
				<video data-src={video} poster={poster} muted loop playsinline preload="none" data-hover-play aria-hidden="true" />
			))
	}
</div>

<script>
	import { onMotionChange } from '../../scripts/phone';
	onMotionChange((enabled) => {
		document.querySelectorAll<HTMLVideoElement>('video[data-decorative-clip]').forEach((clip) => {
			clip.hidden = !enabled;
			if (enabled) {
				if (!clip.getAttribute('src')) clip.src = clip.dataset.src!;
				clip.play().catch(() => {});
			} else clip.pause();
		});
		document.querySelectorAll<HTMLImageElement>('img[data-motion-src]').forEach((img) => {
			img.src = enabled ? img.dataset.motionSrc! : img.dataset.poster!;
		});
	});
</script>

<style>
	.pm {
		position: relative;
		overflow: hidden;
		background: var(--bg-3);
	}
	.pm img,
	.pm video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.pm video[data-hover-play] {
		opacity: 0;
		transition: opacity var(--t-fast) var(--ease);
	}
	:global([data-hover-card]:hover) .pm video[data-hover-play],
	:global([data-hover-card]:focus-visible) .pm video[data-hover-play] {
		opacity: 1;
	}
	.pm video[hidden] {
		display: none;
	}
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px), (hover: none), (pointer: coarse), (prefers-reduced-motion: reduce) {
		.pm video {
			display: none;
		}
	}
</style>
