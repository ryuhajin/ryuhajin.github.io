---
import { nav, type NavId } from '../../site';
import type { HoverItem } from '../../portfolio/hover-sets';
import { themas, themaStorageKey } from '../../portfolio/themes';
import Brand from '../shared/Brand.astro';
import NavTools from '../shared/NavTools.astro';

interface Props {
	/** hero: big vertical menu on the landing page. bar: compact top bar on inner pages. */
	mode: 'hero' | 'bar';
	current?: NavId;
	/** Per-item hover image compositions (hero mode). */
	hoverSets?: Partial<Record<NavId, HoverItem[]>>;
}

const { mode, current, hoverSets = {} } = Astro.props;
const thema = { items: themas, storageKey: themaStorageKey, attr: 'ptheme' };
const pad = (n: number) => String(n).padStart(2, '0');
---

{
	mode === 'hero' ? (
		<nav class="hero-nav" aria-label="Main">
			<ol>
				{nav.map((item, i) => (
					<li>
						<a href={item.href} aria-label={`${pad(i)} ${item.label}`} data-hover-set={JSON.stringify(hoverSets[item.id] ?? [])} data-hint={`${item.hint} →`}>
							<span class="idx mono">{pad(i)}</span>
							<span class="label display gl" style={`view-transition-name: nav-${item.id}`}>
								<span class="glitch" aria-hidden="true">{Array.from(item.label).map((letter) => <span class="nav-letter">{letter}</span>)}</span>
							</span>
						</a>
					</li>
				))}
			</ol>
			<div class="hero-tools" style="view-transition-name: nav-tools">
				<NavTools thema={thema} align="left" sheet />
			</div>
		</nav>
	) : (
		<header class="bar">
			<Brand />
			<div class="bar-right">
				<nav class="desktop-nav" aria-label="Main">
					<ul>
						{nav.map((item) => (
							<li>
								<a href={item.href} class:list={{ active: item.id === current }} aria-current={item.id === current ? 'page' : undefined}>
									<span class="label gl" style={`view-transition-name: nav-${item.id}`}>
										<span class="glitch">{item.label}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</nav>
				<div style="view-transition-name: nav-tools">
					<NavTools thema={thema} sheet />
				</div>
				<button class="mobile-menu-toggle" type="button" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-menu-open>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
				</button>
			</div>
			<dialog id="mobile-navigation" class="mobile-navigation" aria-label="사이트 메뉴" data-mobile-navigation>
				<div class="mobile-navigation-head">
					<span class="mono">Navigation</span>
					<button type="button" class="mobile-menu-close" aria-label="메뉴 닫기" data-mobile-menu-close>✕</button>
				</div>
				<nav aria-label="Main">
					{nav.map((item, i) => (
						<a href={item.href} aria-current={item.id === current ? 'page' : undefined}>
							<span class="mono">{pad(i)}</span><span>{item.label}</span>
						</a>
					))}
				</nav>
			</dialog>
		</header>
	)
}

<script>
	import { PHONE_QUERY } from '../../scripts/phone';
	import { lockPageScroll } from '../../scripts/scroll-lock';
	const trigger = document.querySelector<HTMLButtonElement>('[data-mobile-menu-open]');
	const dialog = document.querySelector<HTMLDialogElement>('[data-mobile-navigation]');
	if (trigger && dialog) {
		const compact = matchMedia(PHONE_QUERY);
		let unlock: (() => void) | undefined;
		const close = () => { if (dialog.open) dialog.close(); };
		trigger.addEventListener('click', () => {
			if (!compact.matches || dialog.open) return;
			document.dispatchEvent(new CustomEvent('site-overlay-open', { detail: { kind: 'navigation', owner: dialog } }));
			unlock = lockPageScroll();
			dialog.showModal();
			trigger.setAttribute('aria-expanded', 'true');
		});
		dialog.querySelector('[data-mobile-menu-close]')?.addEventListener('click', close);
		dialog.addEventListener('click', (event) => {
			if (event.target === dialog || (event.target as Element).closest('a')) close();
		});
		dialog.addEventListener('close', () => {
			unlock?.(); unlock = undefined;
			trigger.setAttribute('aria-expanded', 'false');
			if (compact.matches) trigger.focus({ preventScroll: true });
		});
		compact.addEventListener('change', () => { if (!compact.matches) close(); });
		document.addEventListener('site-overlay-open', (event) => {
			if ((event as CustomEvent).detail.owner !== dialog) close();
		});
		addEventListener('pagehide', close);
	}
</script>

<style>
	/* ---------------- hero (landing) ---------------- */
	.hero-nav ol {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: clamp(0rem, 0.6vh, 0.5rem);
	}
	.hero-nav a {
		position: relative;
		display: grid;
		grid-template-columns: 2.5rem auto;
		align-items: baseline;
		gap: 0.75rem;
		padding-block: 0.15rem;
		transition: opacity var(--t-fast) var(--ease);
	}
	.hero-nav .label {
		font-size: clamp(2.5rem, min(10vh, 15vw), 7rem);
		line-height: 1.02;
		width: fit-content;
		transition:
			transform var(--t-fast) var(--ease-out),
			color var(--t-fast) var(--ease);
	}
	:global(:root[data-ptheme='sky']) .hero-nav .label {
		font-size: clamp(2.25rem, min(9vh, 13vw), 6rem);
	}
	/* no hover line under the big menu (glitch.css .gl::after): it ran into the g / j descenders. The glitch stays */
	.hero-nav .label::after {
		display: none;
	}
	.hero-nav .idx {
		transition: color var(--t-fast);
	}
	.hero-nav ol:has(a:hover) a:not(:hover) {
		opacity: 0.22;
	}
	.hero-nav a:hover .label,
	.hero-nav a:focus-visible .label {
		transform: translateX(0.6rem);
	}
	.hero-nav a:hover .idx {
		color: var(--accent);
	}
	.hero-tools {
		margin: clamp(1rem, 3vh, 1.75rem) 0 0 3.25rem;
		width: fit-content;
	}

	/* ---------------- bar (inner pages) ---------------- */
	.bar {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 50;
		height: var(--nav-h);
		padding-inline: var(--pad);
		display: flex;
		align-items: center;
		justify-content: space-between;
		/* solid on every page, so scrolled content never shows through (the Notes header copies this look) */
		background: var(--bg);
		border-bottom: 1px solid var(--line);
	}
	.bar-right {
		display: flex;
		align-items: center;
		gap: clamp(0.75rem, 2.5vw, 2rem);
	}
	.bar ul {
		list-style: none;
		display: flex;
		gap: clamp(0.75rem, 2.5vw, 2rem);
		margin: 0;
		padding: 0;
	}
	/* nav links only (the brand is a link too and keeps its own layout) */
	.bar nav a {
		position: relative;
		display: inline-block;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--fg-2);
		padding-block: 0.25rem;
		transition: color var(--t-micro) var(--ease);
	}
	.bar nav a:hover {
		color: var(--fg);
	}
	.bar nav a.active {
		color: var(--fg);
	}
	.bar nav a.active :global(.gl::after) {
		background: var(--accent);
	}
	.mobile-menu-toggle { display: none; }
	.mobile-navigation:not([open]) { display: none; }

	/* phones / narrow: size the big menu by width, not height; no hover nudge or dimming */
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		.hero-nav .label,
		:global(:root[data-ptheme='sky']) .hero-nav .label {
			font-size: clamp(2.5rem, 14vw, 4.5rem);
		}
		.hero-nav ol:has(a:hover) a:not(:hover) {
			opacity: 1;
		}
		.hero-nav a:hover .label,
		.hero-nav a:focus-visible .label {
			transform: none;
		}
		/* solid bar: scrolled text never shows through it */
		.bar {
			background: var(--bg);
			border-bottom: 1px solid var(--line);
			padding-top: env(safe-area-inset-top, 0px);
		}
		.bar .desktop-nav, .bar :global(.nav-tools > .gh) { display: none; }
		.bar-right { gap: 0.5rem; }
		.bar :global(.brand .brand-text) { display: inline-flex; min-width: 0; }
		.bar :global(.thema-btn span) { display: none; }
		.bar :global(.thema-btn) { width: 44px; height: 44px; padding: 0; justify-content: center; }
		.mobile-menu-toggle, .mobile-menu-close {
			display: grid; place-items: center; flex: none; width: 44px; height: 44px;
			padding: 0; border: 1px solid var(--line-2); border-radius: 50%;
			background: transparent; color: var(--fg); cursor: pointer;
		}
		.mobile-navigation {
			position: fixed; inset: 0; width: 100%; height: 100dvh; max-width: none; max-height: none;
			margin: 0; padding: calc(10px + env(safe-area-inset-top, 0px)) max(var(--pad), env(safe-area-inset-right, 0px)) calc(24px + env(safe-area-inset-bottom, 0px)) max(var(--pad), env(safe-area-inset-left, 0px));
			border: 0; background: var(--bg); color: var(--fg); overflow-y: auto; overscroll-behavior: contain;
		}
		.mobile-navigation::backdrop { background: #0008; }
		.mobile-navigation-head { display: flex; align-items: center; justify-content: space-between; }
		.mobile-navigation nav { display: grid; margin-top: clamp(1rem, 7vh, 4rem); }
		.bar .mobile-navigation nav a {
			display: grid; grid-template-columns: 2rem minmax(0, 1fr); align-items: baseline; gap: 0.75rem;
			min-height: 56px; padding: 0.5rem 0; font-family: var(--font-display);
			font-size: clamp(2rem, 10vw, 3.5rem); font-weight: var(--display-weight); line-height: 1.15;
			letter-spacing: var(--display-tracking); color: var(--fg-2);
		}
		.bar .mobile-navigation nav a[aria-current='page'] { color: var(--accent); }
	}

	@media (max-width: 640px) {
		.hero-nav a {
			grid-template-columns: 2rem auto;
		}
		/* GitHub + email live on the About page; the bar keeps brand · links · Thema */
		.bar :global(.nav-tools > .gh) {
			display: none;
		}
		.hero-tools {
			margin-left: 2.75rem;
		}
		.bar ul {
			gap: 0.8rem;
		}
		.bar nav a {
			font-size: 0.8125rem;
		}
		.bar :global(.thema-btn span) {
			display: none;
		}
		.bar :global(.thema-btn) {
			padding: 0;
			width: 44px;
			justify-content: center;
		}
	}
</style>
