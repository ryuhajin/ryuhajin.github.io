---
// Landing-page decoration: an SDF shader canvas (segment grid + echo outlines + velocity split).
// Drawn by src/scripts/portfolio/hero-sdf.ts; colours and the shape playlist follow the current Thema.
---

<div class="hero-sdf" aria-hidden="true">
	<canvas data-hero-sdf></canvas>
</div>

<style>
	.hero-sdf {
		position: absolute;
		inset: 0;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	/* 8-bit theme: keep the pixel steps crisp if the buffer is ever scaled */
	:global(html[data-ptheme='gameboy']) canvas {
		image-rendering: pixelated;
	}
	@media (max-width: 820px) {
		.hero-sdf {
			opacity: 0.35;
		}
	}
</style>
