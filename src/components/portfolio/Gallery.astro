---
// Screenshot grid. Clicking a tile opens every gallery image of the page in one <dialog> lightbox
// (←/→ to step, Esc or backdrop click to close) — see scripts/portfolio/lightbox.ts.
interface Item {
	src: string;
	label?: string;
	note?: string;
}
interface Props {
	items: Item[];
	cols?: number;
	ratio?: 'wide' | 'square' | 'auto';
}
const { items, cols = 3, ratio = 'wide' } = Astro.props;
---

<ul class:list={['gallery', `r-${ratio}`]} style={`--cols: ${cols}`}>
	{
		items.map((it, i) => (
			<li style={`--i: ${i}`}>
				<button type="button" class="tile" data-cursor="zoom" data-lightbox={it.src} data-caption={[it.label, it.note].filter(Boolean).join(' — ')}>
					<img src={it.src} alt={it.label ?? ''} loading="lazy" decoding="async" />
				</button>
				{(it.label || it.note) && (
					<p class="cap">
						{it.label && <span class="mono">{it.label}</span>}
						{it.note && <span class="note">{it.note}</span>}
					</p>
				)}
			</li>
		))
	}
</ul>

<style>
	.gallery {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		gap: clamp(0.5rem, 1.2vw, 1rem);
	}
	.tile {
		all: unset;
		display: block;
		width: 100%;
		cursor: zoom-in;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid var(--line-2);
		background: var(--bg-3);
		/* hover outline = 1px border + 2px ring → 3px, without shifting the grid */
		box-shadow: 0 0 0 0 var(--accent-p, var(--accent));
		transition:
			border-color var(--t-fast) var(--ease),
			box-shadow var(--t-fast) var(--ease),
			translate var(--t-fast) var(--ease-out);
	}
	.tile:hover,
	.tile:focus-visible {
		border-color: var(--accent-p, var(--accent));
		box-shadow: 0 0 0 2px var(--accent-p, var(--accent));
		translate: 0 -3px;
	}
	/* the shared cursor badge ("Zoom in") replaces the pointer where it can follow a mouse */
	@media (hover: hover) and (pointer: fine) {
		.tile {
			cursor: none;
		}
	}
	.tile img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.r-wide .tile {
		aspect-ratio: 16 / 9;
	}
	.r-square .tile {
		aspect-ratio: 1;
	}
	.r-auto .tile img {
		height: auto;
	}
	.cap {
		margin: 0.45rem 0 0;
		display: grid;
		gap: 0.15rem;
		font-size: 0.8rem;
		line-height: 1.5;
	}
	.cap .mono {
		color: var(--fg);
	}
	.note {
		color: var(--fg-2);
	}
	@media (max-width: 900px) {
		.gallery {
			grid-template-columns: repeat(min(var(--cols), 2), minmax(0, 1fr));
		}
	}
</style>
