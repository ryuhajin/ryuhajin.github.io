---
// One per page: shows any [data-lightbox] tile large (src/scripts/portfolio/lightbox.ts).
---

<dialog class="lightbox" data-lightbox-dialog aria-label="이미지 크게 보기">
	<figure>
		<img alt="" />
		<figcaption>
			<span data-lightbox-caption></span>
			<span class="mono" data-lightbox-count></span>
		</figcaption>
	</figure>
	<button type="button" class="lb-btn lb-prev" data-lightbox-prev aria-label="이전 이미지">←</button>
	<button type="button" class="lb-btn lb-next" data-lightbox-next aria-label="다음 이미지">→</button>
	<button type="button" class="lb-btn lb-close" data-lightbox-close aria-label="닫기">✕</button>
</dialog>

<script>
	import { initLightbox } from '../../scripts/portfolio/lightbox';
	initLightbox();
</script>

<style>
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: clamp(1rem, 4vw, 3rem);
		border: 0;
		background: transparent;
		color: #fff;
	}
	.lightbox::backdrop {
		background: #000d;
		backdrop-filter: blur(6px);
	}
	.lightbox[open] {
		display: grid;
		place-items: center;
		animation: lb-in var(--t-fast) var(--ease-out);
	}
	@keyframes lb-in {
		from {
			opacity: 0;
			scale: 0.98;
		}
	}
	.lightbox figure {
		margin: 0;
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		max-width: 100%;
		max-height: 100%;
		pointer-events: none;
	}
	.lightbox img {
		max-width: min(100%, 1600px);
		max-height: calc(100dvh - 8rem);
		object-fit: contain;
		border-radius: 6px;
		pointer-events: auto;
	}
	.lightbox figcaption {
		display: flex;
		min-width: 0;
		max-width: 100%;
		overflow-wrap: anywhere;
		gap: 1.5rem;
		font-size: 0.85rem;
		color: #ddd;
	}
	.lb-btn {
		all: unset;
		position: fixed;
		cursor: pointer;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: #fff2;
		color: #fff;
		font-size: 1.1rem;
		transition: background-color var(--t-micro);
	}
	.lb-btn:hover,
	.lb-btn:focus-visible {
		background: #fff4;
	}
	.lb-btn:focus-visible {
		outline: 2px solid #fff;
	}
	.lb-prev {
		left: 1rem;
		top: 50%;
	}
	.lb-next {
		right: 1rem;
		top: 50%;
	}
	.lb-close {
		right: 1rem;
		top: 1rem;
	}
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px), (pointer: coarse) {
		.lightbox {
			box-sizing: border-box;
			padding: calc(4.5rem + env(safe-area-inset-top, 0px)) max(1rem, env(safe-area-inset-right, 0px)) calc(4.5rem + env(safe-area-inset-bottom, 0px)) max(1rem, env(safe-area-inset-left, 0px));
			overflow: auto;
			overscroll-behavior: contain;
		}
		.lightbox figure {
			min-height: 0;
			overflow: auto;
			pointer-events: auto;
		}
		.lightbox img {
			max-height: max(5rem, calc(100dvh - 13rem - env(safe-area-inset-top, 0px) - env(safe-area-inset-bottom, 0px)));
		}
		.lightbox figcaption {
			gap: 0.75rem;
			align-items: start;
			font-size: 1rem;
		}
		[data-lightbox-count] { white-space: nowrap; }
		.lb-prev, .lb-next {
			top: auto;
			bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
		}
		.lb-prev { left: max(1rem, env(safe-area-inset-left, 0px)); }
		.lb-next, .lb-close { right: max(1rem, env(safe-area-inset-right, 0px)); }
		.lb-close { top: calc(1rem + env(safe-area-inset-top, 0px)); }
	}
</style>
