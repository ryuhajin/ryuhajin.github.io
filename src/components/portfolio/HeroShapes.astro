---
// Landing-page decoration on the right edge (partly off-screen). One shape set per theme (see themes.ts `shapes`):
//   geo   — halftone sphere / lissajous / square spiral / moiré / wireframe globe (mono, paper, violet)
//   space — planet, tilted orbits with satellites, star field                         (space)
//   candy — tilted checkerboard plane + separate ribbon bows                            (candy)
//   pixel — pixel sprites with stepped motion                                         (gameboy)
// Animation lives in src/scripts/portfolio/hero-shapes.ts (smooth drift + random glitch hits).

const C = 500;
const round = (n: number) => Math.round(n * 10) / 10;

// geo: halftone sphere — dot size follows lambert shading, light from the upper left
let seed = 7;
const rand = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const halftone: { x: number; y: number; r: number }[] = [];
for (let y = -380; y <= 380; y += 26)
	for (let x = -380; x <= 380; x += 26) {
		const d2 = (x * x + y * y) / (380 * 380);
		if (d2 > 1) continue;
		const z = Math.sqrt(1 - d2);
		const lambert = Math.max(0, (-x * 0.5 - y * 0.6) / 380 + z * 0.62);
		const r = round(0.7 + 7.5 * Math.pow(Math.min(1, lambert), 1.6));
		halftone.push({ x: C + x, y: C + y, r });
	}

// geo: nested squares, each turned 6° and 8% smaller (a square spiral)
const squares = Array.from({ length: 22 }, (_, i) => ({ s: round(760 * Math.pow(0.92, i)), deg: i * 6 }));

// geo: moiré — two families of concentric circles with offset centres
const moire = Array.from({ length: 26 }, (_, i) => 16 + i * 16);

// geo: wireframe globe — latitudes (flattened circles) + longitudes (narrowing ellipses)
const lats = Array.from({ length: 9 }, (_, i) => {
	const phi = ((i + 1) / 10) * Math.PI - Math.PI / 2;
	return { cy: round(C + Math.sin(phi) * 380), rx: round(Math.cos(phi) * 380), ry: round(Math.cos(phi) * 60) };
});
const lons = Array.from({ length: 8 }, (_, i) => round(Math.abs(Math.cos((i / 8) * Math.PI)) * 380));

// space: star field
seed = 42;
const stars = Array.from({ length: 70 }, () => ({ x: round(rand() * 1000), y: round(rand() * 1000), r: round(0.6 + rand() * 1.8) }));

// candy: 8x8 checker cells
const cells = Array.from({ length: 64 }, (_, i) => ({ x: (i % 8) * 60, y: Math.floor(i / 8) * 60, on: ((i % 8) + Math.floor(i / 8)) % 2 === 0 }));

// pixel: 16x16 star sprite
const sprite = [
	'.......##.......',
	'.......##.......',
	'......####......',
	'......####......',
	'.....######.....',
	'################',
	'.##############.',
	'...##########...',
	'....########....',
	'....########....',
	'...####..####...',
	'...###....###...',
	'..###......###..',
	'..##........##..',
	'.##..........##.',
	'.#............#.',
];
const px = sprite.flatMap((row, y) => [...row].map((c, x) => (c === '#' ? { x, y } : null)).filter(Boolean)) as { x: number; y: number }[];
const spark = 'M12 0C12.9 7.6 16.4 11.1 24 12C16.4 12.9 12.9 16.4 12 24C11.1 16.4 7.6 12.9 0 12C7.6 11.1 11.1 7.6 12 0Z';
---

<div class="hero-shapes" aria-hidden="true" data-hero-shapes>
	<svg viewBox="0 0 1000 1000" preserveAspectRatio="xMidYMid meet">
		<defs>
			<clipPath id="hs-band-a"><rect class="band" x="0" y="300" width="1000" height="40"></rect></clipPath>
			<clipPath id="hs-band-b"><rect class="band" x="0" y="560" width="1000" height="70"></rect></clipPath>
			<clipPath id="hs-band-c"><rect class="band" x="0" y="720" width="1000" height="24"></rect></clipPath>
		</defs>

		<!-- geo -->
		<g class="set" data-set="geo">
			<g class="spin" id="hs-spin-geo">
				<g class="layer on" data-layer="halftone">
					{halftone.map((p) => <circle cx={p.x} cy={p.y} r={p.r} />)}
				</g>
				<g class="layer" data-layer="lissajous" fill="none">
					<path class="liss" d=""></path>
				</g>
				<g class="layer" data-layer="squares" fill="none">
					{squares.map((q) => <rect x={C - q.s / 2} y={C - q.s / 2} width={q.s} height={q.s} transform={`rotate(${q.deg} ${C} ${C})`} />)}
				</g>
				<g class="layer" data-layer="moire" fill="none">
					{moire.map((r) => <circle cx={C - 40} cy={C} r={r} />)}
					{moire.map((r) => <circle cx={C + 40} cy={C + 18} r={r} />)}
				</g>
				<g class="layer" data-layer="globe" fill="none">
					<circle cx={C} cy={C} r="380" />
					{lats.map((l) => <ellipse cx={C} cy={l.cy} rx={l.rx} ry={l.ry} />)}
					{lons.map((rx) => <ellipse cx={C} cy={C} rx={rx} ry="380" />)}
				</g>
			</g>
			<g class="sparks">
				<path d={spark} transform="translate(640 60) scale(2.2)"></path>
				<path d={spark} transform="translate(150 60) scale(1.2)"></path>
				<path d={spark} transform="translate(860 520) scale(1)"></path>
			</g>
		</g>

		<!-- space -->
		<g class="set" data-set="space">
			<g class="starfield">{stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} />)}</g>
			<g class="spin" id="hs-spin-space">
				<g class="layer on" data-layer="orbits" fill="none">
					<ellipse cx={C} cy={C} rx="440" ry="150" transform={`rotate(-24 ${C} ${C})`} />
					<ellipse cx={C} cy={C} rx="340" ry="110" transform={`rotate(-24 ${C} ${C})`} />
					<ellipse cx={C} cy={C} rx="250" ry="80" transform={`rotate(-24 ${C} ${C})`} stroke-dasharray="6 10" />
				</g>
			</g>
			<g transform={`rotate(-24 ${C} ${C})`}>
				<ellipse class="planet-ring back" cx={C} cy={C} rx="230" ry="46" fill="none"></ellipse>
			</g>
			<circle class="planet" cx={C} cy={C} r="150"></circle>
			<g transform={`rotate(-24 ${C} ${C})`}>
				<!-- front half of the ring passes in front of the planet -->
				<path class="planet-ring" d={`M ${C - 230} ${C} A 230 46 0 0 0 ${C + 230} ${C}`} fill="none"></path>
			</g>
			<circle class="sat" data-orbit="440,150,-24,0.35" r="12"></circle>
			<circle class="sat red" data-orbit="340,110,-24,-0.55" r="9"></circle>
			<circle class="sat" data-orbit="250,80,-24,0.9" r="6"></circle>
		</g>

		<!-- candy -->
		<g class="set" data-set="candy">
			<g class="spin" id="hs-spin-candy">
				<g class="layer on checker" transform="translate(260 240) rotate(-14 240 240)">
					{cells.map((c) => <rect x={c.x} y={c.y} width="60" height="60" class:list={{ on: c.on }} />)}
					<rect x="0" y="0" width="480" height="480" fill="none" class="frame" />
				</g>
			</g>
			<g class="bow bow-a" transform="translate(250 700) rotate(-12)">
				<path d="M0 0 C -70 -70, -150 -30, -120 40 C -100 80, -40 40, 0 0Z"></path>
				<path d="M0 0 C 70 -70, 150 -30, 120 40 C 100 80, 40 40, 0 0Z"></path>
				<path d="M-6 6 L -50 130 L -26 118 L -12 140 Z"></path>
				<path d="M6 6 L 50 130 L 26 118 L 12 140 Z"></path>
				<circle r="18"></circle>
			</g>
			<g class="bow bow-b" transform="translate(820 180) rotate(16) scale(0.62)">
				<path d="M0 0 C -70 -70, -150 -30, -120 40 C -100 80, -40 40, 0 0Z"></path>
				<path d="M0 0 C 70 -70, 150 -30, 120 40 C 100 80, 40 40, 0 0Z"></path>
				<path d="M-6 6 L -50 130 L -26 118 L -12 140 Z"></path>
				<path d="M6 6 L 50 130 L 26 118 L 12 140 Z"></path>
				<circle r="18"></circle>
			</g>
		</g>

		<!-- pixel -->
		<g class="set" data-set="pixel">
			<g class="spin" id="hs-spin-pixel">
				<g class="layer on" transform="translate(180 180) scale(40)">
					{px.map((p) => <rect x={p.x} y={p.y} width="1" height="1" />)}
				</g>
			</g>
			<g class="pixel-grid">
				{Array.from({ length: 10 }, (_, i) => <rect x={40 + i * 96} y="930" width="48" height="48" />)}
			</g>
		</g>

		<!-- glitch slices: <use> copies of the active spin group, clipped to thin bands (filled in by the script) -->
		<g class="slices"></g>
	</svg>
</div>

<style>
	/* about 30% of the right and bottom edges run off-screen */
	.hero-shapes {
		--hs: min(96vh, 66vw);
		position: absolute;
		right: calc(var(--hs) * -0.3);
		bottom: calc(var(--hs) * -0.3);
		width: var(--hs);
		aspect-ratio: 1;
		z-index: 0;
		pointer-events: none;
	}
	svg {
		width: 100%;
		height: 100%;
		overflow: visible;
		stroke: var(--shape);
		fill: var(--shape);
	}
	.set,
	.layer {
		display: none;
	}
	.layer:global(.on) {
		display: inline;
	}
	:global(:root:not([data-ptheme])) .set[data-set='geo'],
	:global(:root[data-ptheme='mono']) .set[data-set='geo'],
	:global(:root[data-ptheme='paper']) .set[data-set='geo'],
	:global(:root[data-ptheme='violet']) .set[data-set='geo'],
	:global(:root[data-ptheme='space']) .set[data-set='space'],
	:global(:root[data-ptheme='candy']) .set[data-set='candy'],
	:global(:root[data-ptheme='gameboy']) .set[data-set='pixel'] {
		display: inline;
	}

	/* geo */
	[data-layer='halftone'] {
		stroke: none;
	}
	[data-layer='lissajous'] {
		stroke-width: 1.4;
	}
	[data-layer='squares'],
	[data-layer='moire'],
	[data-layer='globe'] {
		stroke-width: 1.5;
	}
	.sparks path {
		stroke: none;
		fill: var(--accent);
		transform-box: fill-box;
		transform-origin: center;
		animation: hs-twinkle 3.6s ease-in-out infinite;
	}
	.sparks path:nth-child(2) {
		animation-delay: -1.2s;
	}
	.sparks path:nth-child(3) {
		animation-delay: -2.4s;
	}
	@keyframes hs-twinkle {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.25;
		}
	}

	/* space */
	.starfield {
		stroke: none;
		fill: var(--fg-2);
		opacity: 0.7;
	}
	[data-layer='orbits'] {
		stroke-width: 1.4;
		opacity: 0.8;
	}
	.planet {
		fill: var(--shape-fill);
		stroke: var(--shape);
		stroke-width: 2;
	}
	.planet-ring {
		stroke: var(--shape);
		stroke-width: 6;
	}
	.planet-ring.back {
		opacity: 0.45;
	}
	.sat {
		fill: var(--shape);
		stroke: none;
	}
	.sat.red {
		fill: var(--accent);
	}

	/* candy */
	.checker rect {
		stroke: none;
		fill: transparent;
	}
	.checker rect:global(.on) {
		fill: var(--shape-fill);
	}
	.checker .frame {
		stroke: var(--shape);
		stroke-width: 3;
	}
	.bow {
		stroke: none;
	}
	.bow-a path,
	.bow-a circle {
		fill: var(--shape);
	}
	.bow-b path,
	.bow-b circle {
		fill: var(--accent);
	}

	/* pixel */
	.set[data-set='pixel'] {
		stroke: none;
		shape-rendering: crispEdges;
	}
	.pixel-grid rect {
		fill: var(--shape-fill);
	}

	/* glitch helpers toggled by the script */
	.slices :global(use) {
		pointer-events: none;
	}

	@media (max-width: 820px) {
		.hero-shapes {
			--hs: 110vw;
			opacity: 0.22;
		}
	}
</style>
