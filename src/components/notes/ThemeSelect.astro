---
import { Icon } from '@astrojs/starlight/components';
import { palettes, storageKey } from '../../notes/palettes.mjs';
---

<notes-palette-select>
	<label>
		<span class="sr-only">색상 테마</span>
		<span class="swatch" aria-hidden="true"></span>
		<select autocomplete="off">
			{palettes.map((p) => <option value={p.id}>{p.label}</option>)}
		</select>
		<Icon name="down-caret" class="caret" />
	</label>
</notes-palette-select>

<script is:inline define:vars={{ palettes, storageKey }}>
	if (!customElements.get('notes-palette-select')) {
		const byId = Object.fromEntries(palettes.map((p) => [p.id, p]));
		const apply = (id) => {
			const p = byId[id] ?? palettes[0];
			const root = document.documentElement;
			root.dataset.palette = p.id;
			root.dataset.theme = p.mode;
			try {
				localStorage.setItem(storageKey, p.id);
			} catch {}
			document.querySelectorAll('notes-palette-select').forEach((el) => el.sync());
		};
		customElements.define(
			'notes-palette-select',
			class extends HTMLElement {
				connectedCallback() {
					this.select = this.querySelector('select');
					this.swatch = this.querySelector('.swatch');
					this.sync();
					this.select.addEventListener('change', () => apply(this.select.value));
				}
				sync() {
					const id = document.documentElement.dataset.palette;
					if (this.select) this.select.value = id;
					if (this.swatch) this.swatch.style.background = byId[id]?.swatch ?? '';
				}
			}
		);
	}
</script>

<style>
	label {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
	}
	label:hover {
		color: var(--sl-color-white);
	}
	.swatch {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		box-shadow: 0 0 0 2px var(--sl-color-bg-nav), 0 0 0 3px var(--sl-color-hairline-light);
		flex: none;
		pointer-events: none;
	}
	select {
		appearance: none;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.375rem;
		background: transparent;
		color: inherit;
		font: inherit;
		padding: 0.25rem 1.6rem 0.25rem 0.5rem;
		cursor: pointer;
	}
	select:hover {
		border-color: var(--sl-color-gray-4);
	}
	option {
		background-color: var(--sl-color-bg-nav);
		color: var(--sl-color-gray-1);
	}
	.caret {
		position: absolute;
		right: 0.35rem;
		pointer-events: none;
		font-size: 1rem;
	}
</style>
