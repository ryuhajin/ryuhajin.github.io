---
// Projects: an image-led masonry (Studio Feixen-like). Words stay hidden until hover; line icons filter by work type.
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import CategoryIcon from '../../components/portfolio/CategoryIcon.astro';
import { categories } from '../../portfolio/categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
const count = (id: string) => projects.filter((p) => (p.data.categories as string[]).includes(id)).length;
---

<PortfolioLayout title="Projects" current="projects">
	<main class="projects">
		<header class="head">
			<h1>
				Selected Projects <sup class="mono">({pad(projects.length)})</sup>
			</h1>
		</header>

		<!-- the filter sits on the grid it filters, right-aligned just above the first row -->
		<div class="filter-row">
			<div class="filter" role="group" aria-label="분야별로 보기" data-filter>
				<button type="button" data-type="all" aria-pressed="true">
					<CategoryIcon id="all" />
					<span class="mono">All</span>
				</button>
				{
					categories.map((c) => (
						<button type="button" data-type={c.id} aria-pressed="false" disabled={count(c.id) === 0}>
							<CategoryIcon id={c.id} />
							<span class="mono">
								{c.label} <sup>{pad(count(c.id))}</sup>
							</span>
						</button>
					))
				}
			</div>
		</div>

		<div class="masonry" data-masonry>
			{
				projects.map((p, i) => {
					const ratio = p.data.tile?.ratio ?? '4/3';
					return (
						<a
							href={`/projects/${p.id}/`}
							class="tile"
							data-tile
							data-hover-card
							data-cats={p.data.categories.join(' ')}
							data-ratio={ratio}
							style={`--ratio: ${ratio}; --accent-p: ${p.data.accent}; --i: ${i}`}
						>
							<ProjectMedia
								class="tile-media"
								poster={p.data.tile?.src ?? p.data.cover.poster}
								video={p.data.cover.video}
								alt={p.data.cover.alt}
								eager={i < 3}
								vtName={`media-${p.id}`}
							/>
							<span class="label">
								<span class="mono idx">P/{pad(i + 1)}</span>
								<strong>{p.data.title}</strong>
								<span class="icons">
									{p.data.categories.map((c) => (
										<CategoryIcon id={c} />
									))}
								</span>
								<span class="mono year">{p.data.year}</span>
							</span>
						</a>
					);
				})
			}
		</div>
	</main>
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';
	import { initMasonry } from '../../scripts/portfolio/masonry';

	initHoverMedia();

	const root = document.querySelector<HTMLElement>('[data-masonry]');
	const bar = document.querySelector<HTMLElement>('[data-filter]');
	if (root && bar) {
		const grid = initMasonry(root);
		const tiles = [...root.querySelectorAll<HTMLElement>('[data-tile]')];
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-type]')];
		const apply = (type: string) => {
			if (!buttons.some((b) => b.dataset.type === type && !b.disabled)) type = 'all';
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === type)));
			tiles.forEach((t) => (t.hidden = type !== 'all' && !t.dataset.cats!.split(' ').includes(type)));
			grid.relayout();
			const url = new URL(location.href);
			if (type === 'all') url.searchParams.delete('type');
			else url.searchParams.set('type', type);
			history.replaceState(history.state, '', url);
		};
		buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.type!)));
		apply(new URLSearchParams(location.search).get('type') ?? 'all');
	}
</script>

<style>
	/* the portfolio side locks body scrolling (portfolio.css); this page scrolls */
	:global(body:has(main.projects)) {
		overflow: auto;
	}
	.projects {
		padding: calc(var(--nav-h) + clamp(2.5rem, 8vh, 5.5rem)) var(--gutter) calc(clamp(3rem, 8vh, 5rem) + env(safe-area-inset-bottom, 0px));
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-bottom: var(--head-gap);
	}
	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4.5vh, 3rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 1;
	}
	h1 sup {
		font-size: 0.8rem;
		vertical-align: top;
		color: var(--fg-3);
	}

	/* ---------- filter: line icons, Feixen-style ---------- */
	.filter-row {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 0.75rem;
	}
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem clamp(0.75rem, 2vw, 1.5rem);
	}
	.filter button {
		all: unset;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0;
		color: var(--fg-3);
		transition: color var(--t-micro);
	}
	.filter button:hover {
		color: var(--fg-2);
	}
	/* selected: full text colour, no underline */
	.filter button[aria-pressed='true'] {
		color: var(--fg);
	}
	.filter button:disabled {
		cursor: default;
		opacity: 0.35;
	}
	.filter button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.filter .mono {
		color: inherit;
		font-size: 0.75rem;
	}
	.filter sup {
		font-size: 0.6rem;
		color: var(--fg-3);
	}

	/* ---------- masonry: CSS columns until the script lays out row order ---------- */
	.masonry {
		columns: 3;
		column-gap: 10px;
	}
	.masonry.is-masonry {
		columns: auto;
		display: flex;
		gap: 10px;
		align-items: flex-start;
	}
	.masonry :global(.mcol) {
		flex: 1;
		min-width: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.tile {
		position: relative;
		display: block;
		break-inside: avoid;
		margin-bottom: 10px;
		overflow: hidden;
		background: var(--bg-2);
		animation: rise var(--t-page) var(--ease-out) both;
		animation-delay: calc(var(--i) * 50ms + 80ms);
		transition: opacity var(--t-fast) var(--ease);
	}
	.is-masonry .tile {
		margin-bottom: 0;
	}
	.tile[hidden] {
		display: none;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	.tile :global(.tile-media) {
		aspect-ratio: var(--ratio);
	}
	.tile :global(.tile-media img) {
		transition: transform 600ms var(--ease-out);
	}
	.tile:hover :global(.tile-media img) {
		transform: scale(1.03);
	}
	.masonry:has(.tile:hover) .tile:not(:hover) {
		opacity: 0.45;
	}

	/* label: hidden until hover, a square band along the bottom edge */
	.label {
		position: absolute;
		inset: auto 0 0 0;
		display: grid;
		grid-template-columns: auto 1fr auto auto;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 0.85rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(6px);
		opacity: 0;
		translate: 0 0.5rem;
		transition:
			opacity var(--t-fast) var(--ease),
			translate var(--t-fast) var(--ease-out);
	}
	.tile:hover .label,
	.tile:focus-visible .label {
		opacity: 1;
		translate: 0 0;
	}
	.label .idx {
		color: var(--accent-p);
	}
	.label strong {
		min-width: 0;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: 1.05rem;
		line-height: 1.2;
		color: var(--fg);
	}
	.label .icons {
		display: inline-flex;
		gap: 0.25rem;
		color: var(--fg-2);
	}
	.label .icons :global(.cat-icon) {
		width: 1.15rem;
		height: 1.15rem;
	}
	.label .year {
		color: var(--fg-3);
	}
	.tile:focus-visible {
		outline: 2px solid var(--accent-p);
		outline-offset: -2px;
	}

	/* Compact layouts and touch always expose the title; no hover is needed to identify a project. */
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px), (hover: none), (pointer: coarse) {
		.label {
			opacity: 1;
			translate: 0 0;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.4rem 0.75rem;
		}
		.label .idx {
			grid-column: 1;
			grid-row: 1;
		}
		.label .year {
			grid-column: 2;
			grid-row: 1;
			text-align: right;
		}
		.label strong {
			grid-column: 1;
			grid-row: 2;
			overflow-wrap: anywhere;
		}
		.label .icons {
			grid-column: 2;
			grid-row: 2;
		}
		.filter button {
			min-width: 44px;
			min-height: 44px;
			box-sizing: border-box;
		}
		.tile:hover :global(.tile-media img) {
			transform: none;
		}
		.masonry:has(.tile:hover) .tile:not(:hover) {
			opacity: 1;
		}
	}
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		h1 {
			font-size: clamp(2rem, 9vw, 2.75rem);
			overflow-wrap: anywhere;
		}
		.filter-row {
			justify-content: flex-start;
		}
	}
	@media (max-width: 1024px) {
		.masonry {
			columns: 2;
		}
	}
	@media (max-width: 640px) {
		.masonry {
			columns: 1;
		}
		h1 {
			font-size: clamp(2rem, 10vw, 2.75rem);
		}
		.filter .mono sup {
			display: none;
		}
		.filter-row {
			justify-content: flex-start;
		}
	}
</style>
