---
// Projects: one disc per project in a 3-column grid, newest first, title and info under each.
// Pointing at a disc: it tilts toward the pointer, a soft prism tint flows across it, a few coloured sparkles
// twinkle once round the rim, the title shows inside, and the other discs turn grey. Icons filter by work type.
// Per-project thumbnail tuning lives in each project's `tile` (src/content.config.ts).
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import CategoryIcon from '../../components/portfolio/CategoryIcon.astro';
import { categories } from '../../portfolio/categories';

const projects = await getCollection('projects');
const pad = (n: number) => String(n).padStart(2, '0');
const count = (id: string) => projects.filter((p) => (p.data.categories as string[]).includes(id)).length;
const label = (id: string) => categories.find((c) => c.id === id)?.label ?? id;
// Project numbers count up in time: the oldest is 01, the newest the highest. Same year → the one with the larger
// `order` counts as older. The grid shows the newest first.
const chrono = [...projects].sort((a, b) => a.data.year.localeCompare(b.data.year) || b.data.order - a.data.order);
const no = (id: string) => pad(chrono.findIndex((p) => p.id === id) + 1);
const newestFirst = [...chrono].reverse();
---

<PortfolioLayout title="Projects" current="projects">
	<main class="projects">
		<header class="head">
			<h1>
				Selected Projects <sup class="mono">({pad(projects.length)})</sup>
			</h1>
		</header>

		<!-- the filter sits on the grid it filters, right-aligned above the first row -->
		<div class="filter-row">
			<div class="filter" role="group" aria-label="분야별로 보기" data-filter>
				<button type="button" data-type="all" aria-pressed="true">
					<CategoryIcon id="all" />
					<span class="mono">
						All <span class="cnt">({pad(projects.length)})</span>
					</span>
				</button>
				{
					categories.map((c) => (
						<button type="button" data-type={c.id} aria-pressed="false" disabled={count(c.id) === 0}>
							<CategoryIcon id={c.id} />
							<span class="mono">
								{c.label} <span class="cnt">({pad(count(c.id))})</span>
							</span>
						</button>
					))
				}
			</div>
		</div>

		<ol class="discs" data-discs>
			{
				newestFirst.map((p, i) => {
					const t = p.data.tile;
					const vars = [
						`--accent-p: ${p.data.accent}`,
						`--i: ${i}`,
						t?.fill && `--d-fill: ${t.fill}`,
						t?.fit && `--d-fit: ${t.fit}`,
						t?.scale && `--d-scale: ${t.scale}`,
						t?.brightness && `--d-bright: ${t.brightness}`,
						t?.blend && `--d-blend: ${t.blend}`,
					];
					return (
						<li data-item data-cats={p.data.categories.join(' ')} style={vars.filter(Boolean).join('; ')}>
							<a href={`/projects/${p.id}/`} class="cell" data-hover-card>
								<span class="stage">
									<span class="disc">
										<ProjectMedia
											class="media"
											poster={t?.src ?? p.data.cover.poster}
											video={p.data.cover.video}
											alt={p.data.cover.alt}
											eager={i < 3}
										/>
										<span class="holo" aria-hidden="true" />
										<span class="inside">
											<strong>{p.data.title}</strong>
											<span class="mono">{p.data.categories.map(label).join(' · ')}</span>
										</span>
									</span>
									<span class="sparks" aria-hidden="true" />
								</span>
								<span class="caption">
									<strong>{p.data.title}</strong>
									<span class="mono sub">
										{p.data.categories.map(label).join(' · ')} — {p.data.year}
									</span>
								</span>
							</a>
						</li>
					);
				})
			}
		</ol>
	</main>
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';

	initHoverMedia();

	// ---------- filter ----------
	const bar = document.querySelector<HTMLElement>('[data-filter]');
	const items = [...document.querySelectorAll<HTMLElement>('[data-discs] [data-item]')];
	if (bar) {
		const buttons = [...bar.querySelectorAll<HTMLButtonElement>('[data-type]')];
		const apply = (type: string) => {
			if (!buttons.some((b) => b.dataset.type === type && !b.disabled)) type = 'all';
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === type)));
			items.forEach((li) => (li.hidden = type !== 'all' && !li.dataset.cats!.split(' ').includes(type)));
			const url = new URL(location.href);
			if (type === 'all') url.searchParams.delete('type');
			else url.searchParams.set('type', type);
			history.replaceState(history.state, '', url);
		};
		buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.type!)));
		apply(new URLSearchParams(location.search).get('type') ?? 'all');
	}

	// ---------- disc hover: tilt toward the pointer, a burst of sparkles round the rim ----------
	const STAR =
		'<svg viewBox="0 0 24 24"><path d="M12 0C12 6.6 17.4 12 24 12 17.4 12 12 17.4 12 24 12 17.4 6.6 12 0 12 6.6 12 12 6.6 12 0Z"/></svg>';
	// the prism of the holo tint: sky, lilac, rose, honey, mint, and one plain light
	const SPARK_COLORS = ['#9fd8ff', '#c6b0ff', '#ffa8d4', '#ffd98f', '#9ff2d4', '#f6f3ec'];
	const still = matchMedia('(prefers-reduced-motion: reduce)');
	const fine = matchMedia('(hover: hover) and (pointer: fine)');
	// -1…1 from the centre, gently bent so small moves still show; up to ±12°
	const bend = (v: number) => Math.sign(v) * Math.abs(v) ** 0.8 * 12;

	for (const stage of document.querySelectorAll<HTMLElement>('[data-discs] .stage')) {
		const disc = stage.querySelector<HTMLElement>('.disc')!;
		const sparks = stage.querySelector<HTMLElement>('.sparks')!;
		let timers: number[] = [];
		const spark = () => {
			// the sparks box is 112% of the stage, so the rim sits at ~44.6% from its centre
			const a = Math.random() * Math.PI * 2;
			const r = 42 + Math.random() * 8;
			const s = document.createElement('span');
			s.className = 'spark';
			s.style.left = `${50 + r * Math.cos(a)}%`;
			s.style.top = `${50 + r * Math.sin(a)}%`;
			s.style.setProperty('--s', `${7 + Math.random() * 9}px`);
			s.style.setProperty('--d', `${650 + Math.random() * 450}ms`);
			s.style.setProperty('--c', SPARK_COLORS[Math.floor(Math.random() * SPARK_COLORS.length)]);
			s.innerHTML = STAR;
			s.addEventListener('animationend', () => s.remove());
			sparks.append(s);
		};
		disc.addEventListener('pointerenter', () => {
			if (!fine.matches || still.matches) return;
			timers = Array.from({ length: 7 }, (_, i) => window.setTimeout(spark, i * 110 + Math.random() * 80));
			stage.classList.add('is-live');
		});
		disc.addEventListener('pointermove', (e) => {
			if (!fine.matches || still.matches) return;
			const r = disc.getBoundingClientRect();
			const x = (e.clientX - r.left) / r.width;
			const y = (e.clientY - r.top) / r.height;
			stage.style.setProperty('--rx', `${bend((0.5 - y) * 2)}deg`);
			stage.style.setProperty('--ry', `${bend((x - 0.5) * 2)}deg`);
		});
		disc.addEventListener('pointerleave', () => {
			timers.forEach(clearTimeout);
			stage.classList.remove('is-live');
			stage.style.removeProperty('--rx');
			stage.style.removeProperty('--ry');
		});
	}
</script>

<style>
	/* the portfolio side locks body scrolling (portfolio.css); this page scrolls */
	:global(body:has(main.projects)) {
		overflow: auto;
	}
	.projects {
		padding: calc(var(--nav-h) + clamp(2.5rem, 8vh, 5.5rem)) var(--gutter) calc(clamp(3rem, 8vh, 5rem) + env(safe-area-inset-bottom, 0px));
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: end;
		justify-content: space-between;
		gap: 1rem 2rem;
		/* the filter row takes 1.5rem of the band above it, so the grid starts where it would without it */
		margin-bottom: max(1rem, calc(var(--head-gap) - 1.5rem));
	}
	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4.5vh, 3rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 1;
	}
	h1 sup {
		font-size: 0.8rem;
		vertical-align: top;
		color: var(--fg-3);
	}

	/* ---------- filter: icon + word + (count), right-aligned; the chosen one in full text colour ---------- */
	.filter-row {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 2.75rem;
	}
	.filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem clamp(1.25rem, 3vw, 2.5rem);
	}
	.filter button {
		all: unset;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0;
		color: var(--fg-3);
		transition: color var(--t-micro);
	}
	.filter button:hover {
		color: var(--fg-2);
	}
	.filter button[aria-pressed='true'] {
		color: var(--fg);
	}
	.filter button:disabled {
		cursor: default;
		opacity: 0.35;
	}
	.filter button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	/* the Devlog label style: Pretendard as written, counts in brackets */
	.filter .mono {
		color: inherit;
		font-size: 0.875rem;
		letter-spacing: 0;
		text-transform: none;
	}
	.filter .cnt {
		margin-left: 0.15em;
		color: var(--fg-3);
	}

	/* ---------- the discs ---------- */
	.discs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: clamp(3rem, 7vh, 4.5rem) clamp(1.5rem, 4vw, 4rem);
	}
	.discs li {
		min-width: 0;
		animation: rise var(--t-page) var(--ease-out) both;
		animation-delay: calc(var(--i) * 60ms + 80ms);
	}
	.discs li[hidden] {
		display: none;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	.cell {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.4rem;
	}
	.cell:focus-visible {
		outline: none;
	}
	.cell:focus-visible .disc {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}
	/* the stage tilts toward the pointer (--rx / --ry from the script) and eases back when it leaves */
	.stage {
		position: relative;
		display: block;
		width: 80%;
		aspect-ratio: 1;
		container-type: inline-size;
		transform: perspective(700px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
		transition: transform 800ms var(--ease-out);
	}
	.stage:global(.is-live) {
		transition: transform 160ms var(--ease-out);
	}
	/* everything on the disc is cut to the circle, also while the stage is tilted in 3D */
	.disc {
		position: absolute;
		inset: 0;
		display: block;
		border-radius: 50%;
		clip-path: circle(50%);
		overflow: hidden;
		background: var(--d-fill, var(--bg-2));
		transition:
			scale 700ms var(--ease-out),
			filter var(--t-page) var(--ease),
			opacity var(--t-page) var(--ease);
	}
	/* per project (tile.fill / fit / scale / brightness / blend): a smaller or whole picture on a flat colour, a
	   brightness that evens the stills out, and — for light lines on black — the whole picture screened onto the
	   fill, so poster and hover video sit on it as one */
	.disc :global(.media) {
		position: absolute;
		inset: 0;
		background: var(--d-fill, var(--bg-2));
		filter: brightness(var(--d-bright, 1));
		mix-blend-mode: var(--d-blend, normal);
		transition: filter 400ms var(--ease);
	}
	.discs li[style*='--d-blend'] .disc :global(.media) {
		background: transparent;
	}
	.disc :global(.media img),
	.disc :global(.media video) {
		object-fit: var(--d-fit, cover);
		scale: var(--d-scale, 1);
	}

	/* the holo: a soft prism (sky · lilac · rose · honey · mint) in diagonal washes, flowing left → right while
	   pointed at. It repeats along its own diagonal (one cycle = 100cqw, a disc width) and the layer slides, so
	   there are no seams; soft-light at half strength tints without lifting the darks. */
	.holo {
		position: absolute;
		z-index: 1;
		inset: 0 0 0 -111cqw;
		pointer-events: none;
		opacity: 0;
		mix-blend-mode: soft-light;
		background-image: repeating-linear-gradient(
			115deg,
			rgb(120 245 205 / 0.45) 0,
			rgb(110 195 255 / 0.5) 20cqw,
			rgb(175 140 255 / 0.55) 40cqw,
			rgb(255 130 200 / 0.5) 60cqw,
			rgb(255 205 120 / 0.5) 80cqw,
			rgb(120 245 205 / 0.45) 100cqw
		);
		transition: opacity 500ms ease-in-out;
	}
	/* one cycle measured across: 100cqw ÷ sin(115°) ≈ 110.3cqw */
	@keyframes flow {
		to {
			translate: 110.34cqw 0;
		}
	}
	.inside {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 18%;
		text-align: center;
		color: #fff;
		pointer-events: none;
		opacity: 0;
		translate: 0 0.4rem;
		text-shadow:
			0 1px 3px rgb(0 0 0 / 0.55),
			0 0 18px rgb(0 0 0 / 0.35);
		transition:
			opacity 450ms ease-in-out,
			translate 450ms var(--ease-out);
	}
	.inside strong {
		font-family: var(--sans);
		font-weight: 600;
		font-size: clamp(0.95rem, 7cqw, 1.35rem);
		letter-spacing: 0.1em;
		text-transform: uppercase;
		line-height: 1.2;
	}
	.inside .mono {
		padding-top: 0.55rem;
		border-top: 1px solid rgb(255 255 255 / 0.4);
		font-size: 0.75rem;
		letter-spacing: 0;
		text-transform: none;
		color: rgb(255 255 255 / 0.85);
	}

	/* sparkles: four-point stars that grow, turn and fade once, just outside the rim */
	.sparks {
		position: absolute;
		inset: -6%;
		z-index: 3;
		pointer-events: none;
	}
	.sparks :global(.spark) {
		position: absolute;
		width: var(--s);
		height: var(--s);
		translate: -50% -50%;
		animation: spark var(--d, 800ms) ease-in-out forwards;
	}
	.sparks :global(.spark svg) {
		display: block;
		width: 100%;
		height: 100%;
		fill: var(--c, #f4f1ea);
		filter: drop-shadow(0 0 4px var(--c, #fff));
	}
	@keyframes spark {
		0% {
			opacity: 0;
			scale: 0;
			rotate: 0deg;
		}
		50% {
			opacity: 1;
			scale: 1;
			rotate: 80deg;
		}
		100% {
			opacity: 0;
			scale: 0;
			rotate: 160deg;
		}
	}

	/* the line under each disc */
	.caption {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
		text-align: center;
	}
	.caption strong {
		font-family: var(--sans);
		font-weight: 600;
		font-size: 0.9375rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--fg);
	}
	.caption .sub {
		font-size: 0.8125rem;
		letter-spacing: 0;
		text-transform: none;
		color: color-mix(in srgb, var(--fg-2), var(--fg-3));
	}

	/* ---------- pointing at a disc (mouse only; the hit area is the circle) ---------- */
	@media (hover: hover) and (pointer: fine) {
		.disc:hover :global(.media) {
			filter: none; /* the hover video plays as made */
		}
		.disc:hover .holo {
			opacity: 0.5;
			animation: flow 4s linear infinite;
		}
		.disc:hover .inside {
			opacity: 1;
			translate: 0 0;
		}
		.discs:has(.disc:hover) .cell:not(:has(.disc:hover)) .disc {
			filter: grayscale(1);
			opacity: 0.55;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.stage {
			transform: none;
		}
		.disc:hover .holo {
			animation: none;
			opacity: 0;
		}
	}

	/* ---------- narrower screens ---------- */
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px), (hover: none), (pointer: coarse) {
		.filter button {
			min-width: 44px;
			min-height: 44px;
			box-sizing: border-box;
		}
	}
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		h1 {
			font-size: clamp(2rem, 9vw, 2.75rem);
			overflow-wrap: anywhere;
		}
		.filter-row {
			justify-content: flex-start;
			margin-bottom: 2rem;
		}
	}
	@media (max-width: 1024px) {
		.discs {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.discs {
			grid-template-columns: minmax(0, 1fr);
		}
		h1 {
			font-size: clamp(2rem, 10vw, 2.75rem);
		}
		.filter .cnt {
			display: none;
		}
	}
</style>
