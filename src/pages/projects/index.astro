---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import CursorBadge from '../../components/portfolio/CursorBadge.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<PortfolioLayout title="Projects" current="projects">
	<main class="projects" data-view="list">
		<header class="head">
			<h1>
				Selected Projects <sup class="mono">({pad(projects.length)})</sup>
			</h1>
			<div class="toggle mono" role="group" aria-label="보기 방식">
				<span class="toggle-label" aria-hidden="true">View</span>
				<button type="button" data-set-view="list" aria-pressed="true">
					<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 8h12M2 12.5h12"></path></svg>
					List
				</button>
				<button type="button" data-set-view="grid" aria-pressed="false">
					<svg viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="2" width="5" height="5"></rect><rect x="9" y="2" width="5" height="5"></rect><rect x="2" y="9" width="5" height="5"></rect><rect x="9" y="9" width="5" height="5"></rect></svg>
					Grid
				</button>
			</div>
		</header>

		<ol class="grid">
			{
				projects.map((p, i) => (
					<li style={`--accent-p: ${p.data.accent}; --i: ${i}`}>
						<a href={`/projects/${p.id}/`} class="card" data-hover-card>
							<ProjectMedia
								class="media"
								poster={p.data.cover.poster}
								video={p.data.cover.video}
								alt={p.data.cover.alt}
								eager
								vtName={`media-${p.id}`}
							/>
							<div class="info">
								<span class="mono idx">P/{pad(i + 1)} · {p.data.group}</span>
								<h2 style={`view-transition-name: title-${p.id}`}>{p.data.title}</h2>
								<p class="tag">{p.data.tagline}</p>
								<div class="chips">
									{p.data.stack.slice(0, 3).map((s) => (
										<span class="chip">{s}</span>
									))}
									{p.data.sample && <span class="sample-badge">sample</span>}
								</div>
							</div>
						</a>
					</li>
				))
			}
		</ol>

		<ol class="list">
			{
				projects.map((p, i) => (
					<li>
						<a
							href={`/projects/${p.id}/`}
							class="row"
							data-media-src={p.data.cover.poster}
							data-media-video={p.data.cover.video}
							data-accent={p.data.accent}
						>
							<span class="mono">P/{pad(i + 1)}</span>
							<span class="row-title">{p.data.title}</span>
							<span class="row-role">{p.data.group}</span>
							<span class="mono">{p.data.year}</span>
						</a>
					</li>
				))
			}
		</ol>

		<footer class="foot mono">
			<span>hover to preview · click to open</span>
			<span>{projects.some((p) => p.data.sample) && 'sample content — replace in src/content/projects'}</span>
		</footer>
	</main>

	<div class="follow" data-follow aria-hidden="true">
		<img alt="" />
		<video muted loop playsinline hidden></video>
	</div>
	<CursorBadge />
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';

	// v2: list became the default; the old key may still hold an earlier "grid" choice
	const KEY = 'projects-view-v2';
	const main = document.querySelector<HTMLElement>('main.projects');
	if (main) {
		const buttons = [...main.querySelectorAll<HTMLButtonElement>('[data-set-view]')];
		const apply = (view: string) => {
			main.dataset.view = view;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.setView === view)));
			try {
				localStorage.setItem(KEY, view);
			} catch {}
		};
		let saved: string | null = null;
		try {
			saved = localStorage.getItem(KEY);
		} catch {}
		if (saved === 'list' || saved === 'grid') apply(saved);
		buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.setView!)));
	}
	initHoverMedia();
</script>

<style>
	.projects {
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		gap: clamp(1rem, 2.5vh, 1.75rem);
		padding: calc(var(--nav-h) + 1.5vh) var(--pad) var(--pad);
	}
	.head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
	}
	h1 {
		margin: 0;
		font-size: clamp(1.75rem, 4.5vh, 3rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 1;
	}
	h1 sup {
		font-size: 0.8rem;
		vertical-align: top;
		color: var(--fg-3);
	}
	/* view switch: a labelled two-way segment with icons, 2px outline like the nav buttons */
	.toggle {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		border: 2px solid var(--fg-2);
		border-radius: 999px;
		padding: 4px;
		font-size: 0.85rem;
	}
	.toggle-label {
		padding: 0 0.4rem 0 0.7rem;
		color: var(--fg-3);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}
	.toggle button {
		all: unset;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font: inherit;
		font-weight: 600;
		padding: 0.5rem 1.05rem;
		border-radius: 999px;
		color: var(--fg-2);
		transition:
			color var(--t-micro),
			background-color var(--t-micro);
	}
	.toggle svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.8;
		stroke-linecap: round;
	}
	.toggle button:hover {
		color: var(--fg);
		background: var(--bg-3);
	}
	.toggle button[aria-pressed='true'] {
		background: var(--fg);
		color: var(--bg);
	}
	.toggle button:focus-visible {
		outline: 2px solid var(--accent);
	}

	/* ---------------- grid view: three boxes filling one screen ---------------- */
	.grid,
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		min-height: 0;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: minmax(0, 1fr);
		gap: clamp(0.75rem, 1.5vw, 1.25rem);
	}
	.list {
		display: none;
	}
	[data-view='list'] .grid {
		display: none;
	}
	[data-view='list'] .list {
		display: block;
		align-self: center;
	}

	.grid li {
		min-height: 0;
		animation: rise var(--t-page) var(--ease-out) both;
		animation-delay: calc(var(--i) * 50ms + 80ms);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
	}
	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		border: 1px solid var(--line-2);
		border-radius: 14px;
		overflow: hidden;
		background: var(--bg-2);
		cursor: none;
		/* hover outline = 1px border + 2px ring → 3px, the same as the screenshot tiles */
		box-shadow: 0 0 0 0 var(--accent-p);
		transition:
			border-color var(--t-fast) var(--ease),
			box-shadow var(--t-fast) var(--ease),
			transform var(--t-fast) var(--ease-out),
			opacity var(--t-fast) var(--ease);
	}
	.grid:has(.card:hover) .card:not(:hover) {
		opacity: 0.45;
	}
	.card:hover,
	.card:focus-visible {
		border-color: var(--accent-p);
		box-shadow: 0 0 0 2px var(--accent-p);
		transform: translateY(-4px);
	}
	.card :global(.media) {
		flex: 1;
		min-height: 0;
	}
	.card :global(.media img) {
		transition: transform 600ms var(--ease-out);
	}
	.card:hover :global(.media img) {
		transform: scale(1.04);
	}
	.info {
		display: grid;
		gap: 0.45rem;
		padding: 1rem 1.1rem 1.1rem;
		border-top: 1px solid var(--line-2);
		background: var(--bg-2);
	}
	.idx {
		color: var(--accent-p);
	}
	.info h2 {
		margin: 0;
		font-size: clamp(1.1rem, 2.4vh, 1.4rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		width: fit-content;
	}
	.tag {
		margin: 0;
		color: var(--fg-2);
		font-size: 0.8125rem;
		line-height: 1.55;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.15rem;
	}

	/* ---------------- list view: rows + floating preview ---------------- */
	.row {
		display: grid;
		grid-template-columns: 4rem 1fr auto 4rem;
		align-items: baseline;
		gap: 1rem;
		padding: clamp(0.6rem, 2vh, 1.25rem) 0.25rem;
		border-top: 2px solid var(--line-2);
		transition:
			border-color var(--t-fast) var(--ease),
			padding var(--t-fast) var(--ease-out);
	}
	.list li:last-child .row {
		border-bottom: 2px solid var(--line-2);
	}
	.row > * {
		transition: opacity var(--t-fast) var(--ease);
	}
	/* dim the other rows' text only — the rules stay, so the hovered row keeps both of its lines */
	.list:has(.row:hover) .row:not(:hover) > * {
		opacity: 0.3;
	}
	/* hovered row: its own top rule and the next row's top rule (= its bottom edge) light up */
	.row:hover,
	.list li:has(.row:hover) + li .row {
		border-top-color: var(--fg);
	}
	.list li:last-child .row:hover {
		border-bottom-color: var(--fg);
	}
	.row:hover {
		padding-inline: 1.25rem 0.25rem;
	}
	.row-title {
		font-size: clamp(1.5rem, 5vh, 3.25rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 1;
	}
	.row-role {
		color: var(--fg-2);
		font-size: 0.875rem;
	}
	.row .mono:last-child {
		text-align: right;
	}

	.follow {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 40;
		width: clamp(16rem, 26vw, 24rem);
		aspect-ratio: 16 / 10;
		border-radius: 10px;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		scale: 0.6;
		transition:
			opacity var(--t-fast) var(--ease),
			scale var(--t-fast) var(--ease-out);
		box-shadow: 0 30px 60px -20px #000;
	}
	.follow:global(.show) {
		opacity: 1;
		scale: 1;
	}
	.follow img,
	.follow video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	/* the global img/video display:block would otherwise beat the hidden attribute */
	.follow video[hidden] {
		display: none;
	}

	.foot {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	@media (hover: none), (pointer: coarse) {
		.card {
			cursor: pointer;
		}
		.follow {
			display: none;
		}
	}

	/* phones / narrow: stack the boxes; the page may scroll here */
	@media (max-width: 820px) {
		:global(body) {
			overflow: auto;
		}
		.projects {
			height: auto;
			min-height: 100dvh;
		}
		.grid {
			grid-template-columns: 1fr;
		}
		.card :global(.media) {
			flex: none;
			aspect-ratio: 16 / 10;
		}
		.row {
			grid-template-columns: 3rem 1fr;
		}
		.row-role,
		.row .mono:last-child {
			display: none;
		}
		.foot span:last-child {
			display: none;
		}
	}
</style>
