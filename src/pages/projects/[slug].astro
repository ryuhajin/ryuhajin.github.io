---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import 'katex/dist/katex.min.css';
import { mdxComponents } from '../../portfolio/mdx-components';
import Prose from '../../components/portfolio/article/Prose.astro';
import Lightbox from '../../components/portfolio/Lightbox.astro';
import { seriesOf, blockUrl } from '../../portfolio/devlog';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, index: i, next: projects[(i + 1) % projects.length] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
	next: CollectionEntry<'projects'>;
}

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const pad = (n: number) => String(n).padStart(2, '0');
const external = (href: string) => (/^https?:/.test(href) ? { target: '_blank', rel: 'noopener' } : {});
// shown only once the project has published devlog entries
const devlogCount = (await seriesOf(project.id)).length;
---

<PortfolioLayout title={d.title} description={d.tagline} current="projects">
	<main class="article" style={`--accent-p: ${d.accent}`}>
		<header class="hero" aria-hidden="true">
			<div class="hero-img" data-parallax>
				<ProjectMedia class="media" poster={d.cover.poster} alt={d.cover.alt} eager vtName={`media-${project.id}`} />
			</div>
		</header>
		<section class="intro">
			<div class="intro-in">
				<p class="mono eyebrow">
					<span>
						P/{pad(index + 1)} · {d.group} · {d.year}
					</span>
					{d.status && <span class="status">{d.status}</span>}
					{d.sample && <span class="sample-badge">sample content</span>}
				</p>
				<h1 style={`view-transition-name: title-${project.id}`}>{d.title}</h1>
			<div class="under">
				<p class="lead">{d.overview}</p>
				<dl class="meta mono">
					<div>
						<dt>Role</dt>
						<dd>{d.role}</dd>
					</div>
					{
						d.team && (
							<div>
								<dt>Team</dt>
								<dd>{d.team}</dd>
							</div>
						)
					}
					<div>
						<dt>Stack</dt>
						<dd>{d.stack.join(' · ')}</dd>
					</div>
					{
						d.links.length > 0 && (
							<div>
								<dt>Links</dt>
								<dd class="links">
									{d.links.map((l) => (
										<a href={l.href} {...external(l.href)}>
											{l.label.split(' — ')[0]} ↗
										</a>
									))}
								</dd>
							</div>
						)
					}
					{
						devlogCount > 0 && (
							<div>
								<dt>Devlog</dt>
								<dd>
									<a href={blockUrl(project.id)}>{pad(devlogCount)} logs →</a>
								</dd>
							</div>
						)
					}
				</dl>
				</div>
			</div>
		</section>

		<Prose>
			<Content components={mdxComponents} />
		</Prose>

		<footer class="foot">
			<a href="/projects/" class="mono back">← All projects</a>
			<a href={`/projects/${next.id}/`} class="next-card" data-hover-card style={`--accent-n: ${next.data.accent}`}>
				<span class="mono">Next project →</span>
				<ProjectMedia class="next-media" poster={next.data.cover.poster} video={next.data.cover.video} alt={next.data.cover.alt} />
				<strong>{next.data.title}</strong>
			</a>
		</footer>
	</main>

	<Lightbox />
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';
	import { onMotionChange } from '../../scripts/phone';
	initHoverMedia();

	// the cover drifts up slower than the page, so the page reads as scrolling down past it
	const hero = document.querySelector<HTMLElement>('[data-parallax]');
	if (hero) {
		let raf = 0;
		const update = () => {
			raf = 0;
			const y = Math.min(scrollY, innerHeight);
			hero.style.transform = `translate3d(0, ${y * 0.6}px, 0)`;
		};
		const onScroll = () => (raf ||= requestAnimationFrame(update));
		onMotionChange((enabled) => {
			removeEventListener('scroll', onScroll);
			cancelAnimationFrame(raf);
			raf = 0;
			hero.style.transform = '';
			if (enabled) {
				addEventListener('scroll', onScroll, { passive: true });
				update();
			}
		});
	}
</script>

<style>
	/* the portfolio side locks body scrolling (portfolio.css, screen-based pages); this page is a normal long read,
	   so it gives the document scroll back — wheel, keys and scroll restoration all behave as usual */
	:global(body:has(main.article)) {
		overflow: auto;
	}
	.article {
		padding-bottom: clamp(3rem, 8vh, 5rem);
	}

	/* ---------- cover: edge to edge from the top, fades into the page; the intro rises over its lower edge ---------- */
	/* fade by transparency, not by painting --bg, so the page's background texture runs on under it without a seam;
	   the mask sits on the box (not the drifting image) so the lower edge stays soft while the image moves */
	.hero {
		position: relative;
		height: clamp(22rem, 78dvh, 52rem);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
		mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
	}
	.hero-img {
		position: absolute;
		inset: 0;
		will-change: transform;
	}
	.hero-img :global(.media) {
		position: absolute;
		inset: 0;
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		/* top: keeps the nav readable over bright skies */
		background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 70%, transparent), transparent 22%);
		pointer-events: none;
	}
	.intro {
		position: relative;
		margin-top: clamp(-11rem, -16vh, -5rem);
		padding: 0 var(--pad) clamp(4rem, 10vh, 6rem);
	}
	.intro-in {
		width: min(100%, 80rem);
		margin-inline: auto;
	}
	.eyebrow {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		margin: 0 0 0.6rem;
		color: var(--fg-2);
		text-transform: none;
	}
	.status {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--accent-p);
		border-radius: 999px;
		color: var(--accent-p);
		font-size: 0.7rem;
	}
	h1 {
		margin: 0;
		width: fit-content;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: clamp(2.6rem, 9vh, 6rem);
		line-height: 0.95;
	}
	.under {
		margin-top: clamp(1.25rem, 3vh, 2rem);
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}
	.lead {
		margin: 0;
		max-width: 40rem;
		font-size: clamp(1.15rem, 2.6vh, 1.45rem);
		font-weight: 300;
		line-height: 1.6;
		letter-spacing: -0.015em;
		color: var(--fg);
		/* an `overview: |-` block keeps its line breaks; folded (>-) overviews arrive as one line */
		white-space: pre-line;
	}
	/* same dt / dd row as the home page's bottom bar */
	.meta {
		margin: 0;
		display: grid;
		gap: 0.9rem;
		text-transform: none;
	}
	.meta div {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1rem;
	}
	.meta dt {
		color: var(--fg-3);
	}
	/* labels stay mono like the home page; values carry Korean, so they use the text face */
	.meta dd {
		margin: 0;
		color: var(--fg);
		font-family: var(--sans);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.meta .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	.meta a {
		color: var(--fg);
		background: linear-gradient(var(--accent-p), var(--accent-p)) 0 100% / 0 1px no-repeat;
		transition:
			background-size var(--t-fast) var(--ease-out),
			color var(--t-micro);
	}
	.meta a:hover {
		color: var(--accent-p);
		background-size: 100% 1px;
	}

	/* ---------- foot ---------- */
	.foot {
		width: min(100% - 2 * var(--pad), 80rem);
		margin: clamp(4rem, 10vh, 6rem) auto 0;
		display: grid;
		grid-template-columns: 1fr minmax(0, 26rem);
		gap: 2rem;
		align-items: end;
	}
	.back {
		color: var(--fg-2);
		text-transform: none;
	}
	.back:hover {
		color: var(--fg);
	}
	.next-card {
		display: grid;
		gap: 0.75rem;
		cursor: pointer;
	}
	.next-card > .mono {
		color: var(--fg-3);
		text-transform: none;
	}
	.next-card :global(.next-media) {
		aspect-ratio: 16 / 10;
		border-radius: 12px;
		border: 1px solid var(--line-2);
		/* hover outline = 1px border + 1px ring → 2px, without shifting the layout */
		box-shadow: 0 0 0 0 var(--accent-n);
		transition:
			border-color var(--t-fast),
			box-shadow var(--t-fast),
			transform var(--t-fast) var(--ease-out);
	}
	.next-card:hover :global(.next-media) {
		border-color: var(--accent-n);
		box-shadow: 0 0 0 1px var(--accent-n);
		transform: translateY(-4px);
	}
	.next-card strong {
		font-size: 1.5rem;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
	}

	@media (max-width: 900px) {
		.under,
		.foot {
			grid-template-columns: 1fr;
		}
		.hero {
			height: 56vh;
			height: 56dvh;
		}
		h1 {
			font-size: clamp(2.25rem, 11vw, 4rem);
			overflow-wrap: anywhere;
		}
	}
	/* phones / narrow: a still cover with a fixed ratio, text sized by width (not screen height) for reading */
	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		.under, .foot { grid-template-columns: 1fr; }
		h1 {
			font-size: clamp(2.25rem, 9vw, 4rem);
			overflow-wrap: anywhere;
			line-height: 1.05;
		}
		.eyebrow { flex-wrap: wrap; }
		.hero {
			height: auto;
			aspect-ratio: 4 / 3;
			margin-top: var(--nav-h);
			-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
			mask-image: linear-gradient(to bottom, #000 70%, transparent);
		}
		.hero::after {
			display: none;
		}
		.intro {
			margin-top: -3rem;
			padding-bottom: 3rem;
		}
		.lead {
			font-size: 1.0625rem;
			font-weight: 400;
			line-height: 1.7;
		}
		.meta div {
			grid-template-columns: 3.75rem minmax(0, 1fr);
		}
		.meta dd { overflow-wrap: anywhere; }
		.meta a, .back {
			display: inline-flex;
			align-items: center;
			min-height: 44px;
		}
		.next-card:hover :global(.next-media) { transform: none; }
	}
</style>
