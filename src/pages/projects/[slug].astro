---
import { getCollection, type CollectionEntry } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import YouTubeEmbed from '../../components/portfolio/YouTubeEmbed.astro';
import Gallery from '../../components/portfolio/Gallery.astro';
import CompareView from '../../components/portfolio/CompareView.astro';
import Flipbook from '../../components/portfolio/Flipbook.astro';
import PresetCards from '../../components/portfolio/PresetCards.astro';
import CursorBadge from '../../components/portfolio/CursorBadge.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, index: i, next: projects[(i + 1) % projects.length] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
	next: CollectionEntry<'projects'>;
}

const { project, index, next } = Astro.props;
const d = project.data;
const pad = (n: number) => String(n).padStart(2, '0');

// One snap screen per entry; screens without data are left out, and the side dots follow this list.
// A gallery marked `with` joins another screen: 'techniques' becomes that screen's photo strip (and the techniques
// screen takes the gallery's place in the order), 'compare' sits next to the before/after.
type Gallery = (typeof d.galleries)[number];
type Section =
	| { kind: 'intro' | 'video' | 'presets' | 'motion' | 'compare' | 'breakdown' | 'architecture' | 'problems' | 'decisions' | 'next'; label: string }
	| { kind: 'techniques'; label: string; strip?: Gallery }
	| { kind: 'gallery'; label: string; gallery: Gallery };
const strip = d.galleries.find((g) => g.with === 'techniques');
const beside = d.galleries.find((g) => g.with === 'compare');
const techniques: Section[] = d.techniques.length ? [{ kind: 'techniques', label: strip?.title ?? 'Techniques', strip }] : [];
const sections: Section[] = [
	{ kind: 'intro', label: 'Intro' },
	...(d.video ? [{ kind: 'video', label: 'Video' } as const] : []),
	...(strip ? [] : techniques),
	...(d.presets ? [{ kind: 'presets', label: d.presets.title } as const] : []),
	...d.galleries.flatMap((g): Section[] => (g === strip ? techniques : g.with ? [] : [{ kind: 'gallery', label: g.title, gallery: g }])),
	...(d.motion.length ? [{ kind: 'motion', label: 'In motion' } as const] : []),
	...(d.compare ? [{ kind: 'compare', label: d.compare.title } as const] : []),
	...(d.breakdown ? [{ kind: 'breakdown', label: d.breakdown.title } as const] : []),
	...(d.architecture ? [{ kind: 'architecture', label: 'Architecture' } as const] : []),
	...(d.problems.length ? [{ kind: 'problems', label: 'Problem solving' } as const] : []),
	// decisions share the problem-solving screen when there is one
	...(d.decisions.length && !d.problems.length ? [{ kind: 'decisions', label: 'Decisions' } as const] : []),
	{ kind: 'next', label: 'Links' },
];
const num = (s: Section) => pad(sections.indexOf(s));
const videoPoster = d.video?.poster ?? d.cover.poster;
const facts = d.facts.length ? d.facts : [d.year, d.role];
---

<PortfolioLayout title={d.title} description={d.tagline} current="projects">
	<main class="snap" data-snap style={`--accent-p: ${d.accent}`}>
		{
			sections.map((s) => {
				switch (s.kind) {
					case 'intro':
						return (
							<section class="s intro" data-snap-section>
								<div class="wrap">
									<figure class="frame">
										<ProjectMedia class="media" poster={d.cover.poster} video={d.cover.video} alt={d.cover.alt} autoplay eager vtName={`media-${project.id}`} />
										<figcaption>
											<p class="mono eyebrow">
												<span>
													P/{pad(index + 1)} · {d.group} · {d.year}
												</span>
												{d.status && <span class="status">{d.status}</span>}
												{d.sample && <span class="sample-badge">sample content</span>}
											</p>
											<h1 class="title" style={`view-transition-name: title-${project.id}`}>
												{d.title}
											</h1>
										</figcaption>
									</figure>
									<p class="lead">{d.overview}</p>
									{d.beats.length > 0 ? (
										<ol class="beats">
											{d.beats.map((b, i) => (
												<li>
													<span class="mono num">{pad(i + 1)}</span>
													<b>{b.title}</b>
													<span>{b.body}</span>
												</li>
											))}
										</ol>
									) : (
										d.highlights.length > 0 && (
											<ul class="beats plain">
												{d.highlights.slice(0, 3).map((h) => (
													<li>{h}</li>
												))}
											</ul>
										)
									)}
									<p class="mono facts">{facts.join('  /  ')}</p>
								</div>
								<p class="mono scroll-hint">scroll · ↑↓ keys</p>
							</section>
						);
					case 'video':
						return (
							<section class="s video" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>Video</h2>
										<p class="side">
											{d.role}
											<br />
											{d.stack.join(' · ')}
										</p>
									</header>
									<div class="video-box">
										<YouTubeEmbed id={d.video!.youtube} poster={videoPoster} title={d.video!.title ?? `${d.title} 시연 영상`} />
									</div>
								</div>
							</section>
						);
					case 'techniques':
						return (
							<section class="s techniques" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>{s.strip?.title ?? '핵심 기법'}</h2>
									</header>
									{s.strip?.caption && <p class="deck">{s.strip.caption}</p>}
									{s.strip && (
										<div class="strip" style={`--n: ${s.strip.items.length}`}>
											{s.strip.items.map((it) => (
												<button type="button" class="photo" data-cursor="zoom" data-lightbox={it.src} data-caption={[it.label, it.note].filter(Boolean).join(' — ')}>
													<img src={it.src} alt={it.label ?? ''} loading="lazy" decoding="async" />
													<span>
														<b>{it.label?.replace(/^\d+\s·\s/, '')}</b>
														{it.note && <small>{it.note}</small>}
													</span>
												</button>
											))}
										</div>
									)}
									<div class="tech">
										{d.techniques.map((t) => (
											<div>
												<p>
													<b>{t.title}</b>
													{t.body}
												</p>
												{t.formula && <pre class="formula">{t.formula}</pre>}
											</div>
										))}
									</div>
								</div>
							</section>
						);
					case 'presets':
						return (
							<section class="s presets-s" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>{d.presets!.title}</h2>
									</header>
									<PresetCards items={d.presets!.items} />
									{d.presets!.caption && <p class="caption">{d.presets!.caption}</p>}
								</div>
							</section>
						);
					case 'gallery':
						return (
							<section class="s gallery-s" data-snap-section>
								<div class="wrap spine-grid" style={`--gw: ${s.gallery.cols <= 2 ? '60rem' : '1fr'}`}>
									<header class="spine">
										<span class="mono num">{num(s)}</span>
										<h2>{s.gallery.title}</h2>
									</header>
									<div>
										<Gallery items={s.gallery.items} cols={s.gallery.cols} ratio={s.gallery.ratio} />
										{s.gallery.caption && <p class="caption">{s.gallery.caption}</p>}
									</div>
								</div>
							</section>
						);
					case 'motion':
						return (
							<section class="s motion" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>움직임으로 보기</h2>
									</header>
									<div class="flips" style={`--n: ${d.motion.length}`}>
										{d.motion.map((m, i) => (
											<article style={`--i: ${i}`}>
												<Flipbook sprite={m.sprite} frames={m.frames} label={m.title} />
												<p>
													<b>{m.title}</b>
													{m.body}
												</p>
												{m.formula && <pre class="formula">{m.formula}</pre>}
											</article>
										))}
									</div>
								</div>
							</section>
						);
					case 'compare':
						return (
							<section class="s compare" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>{d.compare!.title}</h2>
										{!beside && d.compare!.caption && <p class="side">{d.compare!.caption}</p>}
									</header>
									{beside ? (
										<div class="cmp-grid">
											<CompareView steps={d.compare!.steps} slider={d.compare!.slider} />
											<div>
												<p class="mono num sub">
													{beside.title}
													{beside.caption && ` — ${beside.caption}`}
												</p>
												<div class="dbg">
													{beside.items.map((it) => (
														<button type="button" class="photo" data-cursor="zoom" data-lightbox={it.src} data-caption={[it.label, it.note].filter(Boolean).join(' — ')}>
															<img src={it.src} alt={it.label ?? ''} loading="lazy" decoding="async" />
															{it.label && (
																<span>
																	<b>{it.label.replace(/^[①-⑳]\s/, '')}</b>
																</span>
															)}
														</button>
													))}
												</div>
												{d.compare!.notes.length > 0 && (
													<ul class="mini">
														{d.compare!.notes.map((n) => (
															<li>{n}</li>
														))}
													</ul>
												)}
											</div>
										</div>
									) : (
										<div class="cmp-solo">
											<CompareView steps={d.compare!.steps} slider={d.compare!.slider} />
										</div>
									)}
								</div>
							</section>
						);
					case 'breakdown':
						return (
							<section class="s breakdown" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>{d.breakdown!.title}</h2>
									</header>
									<div class="bd" style={`--n: ${d.breakdown!.columns.length}`}>
										{d.breakdown!.columns.map((c) => (
											<div>
												<h3>{c.title}</h3>
												<ul>
													{c.items.map((it) => (
														<li>{it}</li>
													))}
												</ul>
											</div>
										))}
									</div>
								</div>
							</section>
						);
					case 'architecture':
						return (
							<section class="s arch" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>{d.architecture!.caption ?? 'Architecture'}</h2>
									</header>
									{d.architecture!.image && <img class="arch-img" src={d.architecture!.image} alt={d.architecture!.caption ?? ''} loading="lazy" />}
									<ol class="flow">
										{d.architecture!.points.map((pt, i) => {
											const [head, ...rest] = pt.split(' — ');
											return (
												<li style={`--i: ${i}`}>
													<span class="mono num">{pad(i + 1)}</span>
													<b>{rest.length ? head : `Step ${i + 1}`}</b>
													<span>{rest.length ? rest.join(' — ') : head}</span>
												</li>
											);
										})}
									</ol>
								</div>
							</section>
						);
					case 'problems':
						return (
							<section class="s problems" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>문제와 해결</h2>
									</header>
									<div class="pbs" style={`--n: ${Math.min(d.problems.length, 4)}`}>
										{d.problems.map((pb, i) => (
											<article style={`--i: ${i}`}>
												{pb.metric && <p class="metric">{pb.metric}</p>}
												<h3>{pb.title}</h3>
												<p class="pb-q">{pb.problem}</p>
												<p class="pb-a">{pb.approach}</p>
												<p class="pb-r">{pb.result}</p>
											</article>
										))}
									</div>
									{d.decisions.length > 0 && (
										<>
											<p class="mono num sub dec-sub">Decisions</p>
											<ol class="adr" style={`--n: ${Math.min(d.decisions.length, 3)}`}>
												{d.decisions.map((dc) => (
													<li>
														<b>{dc.choice}</b>
														<span>{dc.why}</span>
													</li>
												))}
											</ol>
										</>
									)}
								</div>
							</section>
						);
					case 'decisions':
						return (
							<section class="s decisions" data-snap-section>
								<div class="wrap">
									<header class="head">
										<span class="mono num">{num(s)}</span>
										<h2>기술적 의사결정</h2>
									</header>
									<ol class="adr" style={`--n: ${Math.min(d.decisions.length, 3)}`}>
										{d.decisions.map((dc) => (
											<li>
												<b>{dc.choice}</b>
												<span>{dc.why}</span>
												{dc.tradeoff && <span class="trade">{dc.tradeoff}</span>}
											</li>
										))}
									</ol>
								</div>
							</section>
						);
					case 'next':
						return (
							<section class="s next" data-snap-section>
								<div class="wrap two">
									<div>
										<header class="head">
											<span class="mono num">{num(s)}</span>
											<h2>{d.limitations.length ? '다음 단계' : 'Links'}</h2>
										</header>
										{d.limitations.length > 0 && (
											<ul class="mini limits">
												{d.limitations.map((l) => (
													<li>{l}</li>
												))}
											</ul>
										)}
										<ul class="links">
											{d.links.map((l) => (
												<li>
													<a href={l.href} {...(/^https?:/.test(l.href) ? { target: '_blank', rel: 'noopener' } : {})}>
														{l.label} <span aria-hidden="true">↗</span>
													</a>
												</li>
											))}
											<li>
												<a href="/projects/">
													All projects <span aria-hidden="true">←</span>
												</a>
											</li>
										</ul>
									</div>
									<a href={`/projects/${next.id}/`} class="next-card" data-hover-card style={`--accent-n: ${next.data.accent}`}>
										<span class="mono">Next project →</span>
										<ProjectMedia class="next-media" poster={next.data.cover.poster} video={next.data.cover.video} alt={next.data.cover.alt} />
										<strong>{next.data.title}</strong>
									</a>
								</div>
							</section>
						);
				}
			})
		}
	</main>

	<nav class="dots" data-snap-nav aria-label="Sections" style={`--accent-p: ${d.accent}`}>
		{
			sections.map((s, i) => (
				<button type="button" data-go={i} aria-label={s.label}>
					<span class="dot-label mono">{s.label}</span>
				</button>
			))
		}
	</nav>
	<p class="counter mono" data-snap-counter aria-live="polite"></p>
	<CursorBadge />

	<dialog class="lightbox" data-lightbox-dialog aria-label="이미지 크게 보기">
		<figure>
			<img alt="" />
			<figcaption>
				<span data-lightbox-caption></span>
				<span class="mono" data-lightbox-count></span>
			</figcaption>
		</figure>
		<button type="button" class="lb-btn lb-prev" data-lightbox-prev aria-label="이전 이미지">←</button>
		<button type="button" class="lb-btn lb-next" data-lightbox-next aria-label="다음 이미지">→</button>
		<button type="button" class="lb-btn lb-close" data-lightbox-close aria-label="닫기">✕</button>
	</dialog>
</PortfolioLayout>

<script>
	import { initSnapSections } from '../../scripts/portfolio/snap-sections';
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';
	import { initLightbox } from '../../scripts/portfolio/lightbox';
	initSnapSections();
	initHoverMedia();
	initLightbox();
</script>

<style>
	.snap {
		height: 100dvh;
		overflow-y: auto;
		scroll-snap-type: y mandatory;
		scrollbar-width: none;
		overscroll-behavior: contain;
	}
	.snap::-webkit-scrollbar {
		display: none;
	}
	.s {
		position: relative;
		/* one screen per section; a screen whose content is taller (short windows) grows instead of clipping */
		min-height: 100dvh;
		scroll-snap-align: start;
		scroll-snap-stop: always;
		display: grid;
		align-items: center;
		padding: calc(var(--nav-h) + 1rem) calc(var(--pad) + 3rem) var(--pad) var(--pad);
		overflow: hidden;
	}
	.wrap {
		width: min(100%, 80rem);
		margin-inline: auto;
	}
	.two {
		display: grid;
		grid-template-columns: 1.4fr 1fr;
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}

	/* ---------- type: hierarchy from size and weight, no rules ---------- */
	.num {
		margin: 0;
		color: var(--accent-p);
		text-transform: none;
		letter-spacing: 0.04em;
	}
	.head {
		display: flex;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: clamp(1rem, 2.5vh, 1.5rem);
	}
	h2 {
		margin: 0;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: clamp(2.2rem, 6vh, 3.5rem);
		line-height: 1;
	}
	.head .side {
		margin: 0 0 0 auto;
		max-width: 28rem;
		text-align: right;
		color: var(--fg-2);
		font-size: 0.85rem;
		font-weight: 300;
		line-height: 1.6;
	}
	h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 650;
		letter-spacing: -0.01em;
	}
	.sub {
		margin-bottom: 0.6rem;
	}
	.deck {
		margin: -0.25rem 0 clamp(1rem, 2.5vh, 1.5rem);
		max-width: 44rem;
		color: var(--fg-2);
		font-size: 1.05rem;
		font-weight: 300;
		line-height: 1.6;
	}
	.caption {
		margin: 0.8rem 0 0;
		max-width: 60rem;
		color: var(--fg-2);
		font-size: 0.85rem;
		font-weight: 300;
		line-height: 1.6;
	}
	.mini {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}
	.mini li {
		color: var(--fg-2);
		font-size: 0.85rem;
		font-weight: 300;
		line-height: 1.55;
	}
	.formula {
		margin: 0.5rem 0 0;
		white-space: pre-wrap;
		font-family: var(--mono);
		font-size: 0.74rem;
		line-height: 1.6;
		color: var(--fg-3);
	}

	/* reveal on entering a screen */
	.s .wrap > *,
	.flow li,
	.pbs article {
		transition:
			opacity 420ms var(--ease),
			transform 520ms var(--ease-out);
		transition-delay: calc(var(--i, 0) * 60ms);
	}
	.s:not(.is-active) .wrap > *,
	.s:not(.is-active) .flow li,
	.s:not(.is-active) .pbs article {
		opacity: 0;
		transform: translateY(24px);
		transition-delay: 0ms;
	}

	/* ---------- photo tiles (strip, debug grid) ---------- */
	.photo {
		all: unset;
		position: relative;
		display: block;
		overflow: hidden;
		cursor: zoom-in;
		background: var(--bg-3);
	}
	@media (hover: hover) and (pointer: fine) {
		.photo {
			cursor: none;
		}
	}
	.photo img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 600ms var(--ease-out);
	}
	.photo:hover img,
	.photo:focus-visible img {
		scale: 1.04;
	}
	.photo:focus-visible {
		outline: 2px solid var(--accent-p);
		outline-offset: -2px;
	}
	.photo span {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 2.5rem 1rem 0.85rem;
		display: grid;
		gap: 0.1rem;
		background: linear-gradient(to top, #000a, transparent);
		color: #fff;
	}
	.photo b {
		font-size: 0.95rem;
		font-weight: 600;
	}
	.photo small {
		color: #fffb;
		font-size: 0.75rem;
		font-weight: 300;
	}

	/* ---------- intro: the moving cover fades in and out, the goal sits under it ---------- */
	.intro .frame {
		position: relative;
		margin: 0;
		height: 50dvh;
		display: grid;
		align-items: end;
	}
	.intro .frame :global(.media) {
		position: absolute;
		inset: 0;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 62%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0%, #000 16%, #000 62%, transparent 100%);
	}
	.intro figcaption {
		position: relative;
		padding-bottom: 0.25rem;
