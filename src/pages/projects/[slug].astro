---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import ProjectMedia from '../../components/portfolio/ProjectMedia.astro';
import CursorBadge from '../../components/portfolio/CursorBadge.astro';
import 'katex/dist/katex.min.css';
// blocks the project .mdx bodies use without importing them
import Figure from '../../components/portfolio/article/Figure.astro';
import Grid from '../../components/portfolio/article/Grid.astro';
import Stats from '../../components/portfolio/article/Stats.astro';
import Block from '../../components/portfolio/article/Block.astro';
import Section from '../../components/portfolio/article/Section.astro';
import YouTube from '../../components/portfolio/YouTubeEmbed.astro';
import Compare from '../../components/portfolio/CompareView.astro';
import Flipbook from '../../components/portfolio/Flipbook.astro';
import PresetCards from '../../components/portfolio/PresetCards.astro';

export async function getStaticPaths() {
	const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, index: i, next: projects[(i + 1) % projects.length] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	index: number;
	next: CollectionEntry<'projects'>;
}

const { project, index, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const pad = (n: number) => String(n).padStart(2, '0');
const external = (href: string) => (/^https?:/.test(href) ? { target: '_blank', rel: 'noopener' } : {});
---

<PortfolioLayout title={d.title} description={d.tagline} current="projects">
	<main class="article" style={`--accent-p: ${d.accent}`}>
		<header class="hero" aria-hidden="true">
			<div class="hero-img" data-parallax>
				<ProjectMedia class="media" poster={d.cover.poster} alt={d.cover.alt} eager vtName={`media-${project.id}`} />
			</div>
		</header>
		<section class="intro">
			<div class="intro-in">
				<p class="mono eyebrow">
					<span>
						P/{pad(index + 1)} · {d.group} · {d.year}
					</span>
					{d.status && <span class="status">{d.status}</span>}
					{d.sample && <span class="sample-badge">sample content</span>}
				</p>
				<h1 style={`view-transition-name: title-${project.id}`}>{d.title}</h1>
			<div class="under">
				<p class="lead">{d.overview}</p>
				<dl class="meta mono">
					<div>
						<dt>Role</dt>
						<dd>{d.role}</dd>
					</div>
					{
						d.team && (
							<div>
								<dt>Team</dt>
								<dd>{d.team}</dd>
							</div>
						)
					}
					<div>
						<dt>Stack</dt>
						<dd>{d.stack.join(' · ')}</dd>
					</div>
					{
						d.links.length > 0 && (
							<div>
								<dt>Links</dt>
								<dd class="links">
									{d.links.map((l) => (
										<a href={l.href} {...external(l.href)}>
											{l.label.split(' — ')[0]} ↗
										</a>
									))}
								</dd>
							</div>
						)
					}
				</dl>
				</div>
			</div>
		</section>

		<article class="prose">
			<Content components={{ Section, Figure, Grid, Stats, Block, YouTube, Compare, Flipbook, PresetCards }} />
		</article>

		<footer class="foot">
			<a href="/projects/" class="mono back">← All projects</a>
			<a href={`/projects/${next.id}/`} class="next-card" data-hover-card style={`--accent-n: ${next.data.accent}`}>
				<span class="mono">Next project →</span>
				<ProjectMedia class="next-media" poster={next.data.cover.poster} video={next.data.cover.video} alt={next.data.cover.alt} />
				<strong>{next.data.title}</strong>
			</a>
		</footer>
	</main>
	<CursorBadge />

	<dialog class="lightbox" data-lightbox-dialog aria-label="이미지 크게 보기">
		<figure>
			<img alt="" />
			<figcaption>
				<span data-lightbox-caption></span>
				<span class="mono" data-lightbox-count></span>
			</figcaption>
		</figure>
		<button type="button" class="lb-btn lb-prev" data-lightbox-prev aria-label="이전 이미지">←</button>
		<button type="button" class="lb-btn lb-next" data-lightbox-next aria-label="다음 이미지">→</button>
		<button type="button" class="lb-btn lb-close" data-lightbox-close aria-label="닫기">✕</button>
	</dialog>
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';
	import { initLightbox } from '../../scripts/portfolio/lightbox';
	initHoverMedia();
	initLightbox();

	// the cover drifts up slower than the page, so the page reads as scrolling down past it
	const hero = document.querySelector<HTMLElement>('[data-parallax]');
	if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let raf = 0;
		const update = () => {
			raf = 0;
			const y = Math.min(scrollY, innerHeight);
			hero.style.transform = `translate3d(0, ${y * 0.6}px, 0)`;
		};
		addEventListener('scroll', () => (raf ||= requestAnimationFrame(update)), { passive: true });
		update();
	}
</script>

<style>
	/* the portfolio side locks body scrolling (portfolio.css, screen-based pages); this page is a normal long read,
	   so it gives the document scroll back — wheel, keys and scroll restoration all behave as usual */
	:global(body:has(main.article)) {
		overflow: auto;
	}
	.article {
		padding-bottom: clamp(3rem, 8vh, 5rem);
	}

	/* ---------- cover: edge to edge from the top, fades into the page; the intro rises over its lower edge ---------- */
	/* fade by transparency, not by painting --bg, so the page's background texture runs on under it without a seam;
	   the mask sits on the box (not the drifting image) so the lower edge stays soft while the image moves */
	.hero {
		position: relative;
		height: clamp(22rem, 78dvh, 52rem);
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
		mask-image: linear-gradient(to bottom, #000 40%, transparent 97%);
	}
	.hero-img {
		position: absolute;
		inset: 0;
		will-change: transform;
	}
	.hero-img :global(.media) {
		position: absolute;
		inset: 0;
	}
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		/* top: keeps the nav readable over bright skies */
		background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 70%, transparent), transparent 22%);
		pointer-events: none;
	}
	.intro {
		position: relative;
		margin-top: clamp(-11rem, -16vh, -5rem);
		padding: 0 var(--pad) clamp(4rem, 10vh, 6rem);
	}
	.intro-in {
		width: min(100%, 80rem);
		margin-inline: auto;
	}
	.eyebrow {
		display: flex;
		gap: 0.75rem;
		align-items: center;
		margin: 0 0 0.6rem;
		color: var(--fg-2);
		text-transform: none;
	}
	.status {
		padding: 0.15rem 0.5rem;
		border: 1px solid var(--accent-p);
		border-radius: 999px;
		color: var(--accent-p);
		font-size: 0.7rem;
	}
	h1 {
		margin: 0;
		width: fit-content;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: clamp(2.6rem, 9vh, 6rem);
		line-height: 0.95;
	}
	.under {
		margin-top: clamp(1.25rem, 3vh, 2rem);
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		align-items: start;
	}
	.lead {
		margin: 0;
		max-width: 40rem;
		font-size: clamp(1.15rem, 2.6vh, 1.45rem);
		font-weight: 300;
		line-height: 1.6;
		letter-spacing: -0.015em;
		color: var(--fg);
		/* an `overview: |-` block keeps its line breaks; folded (>-) overviews arrive as one line */
		white-space: pre-line;
	}
	/* same dt / dd row as the home page's bottom bar */
	.meta {
		margin: 0;
		display: grid;
		gap: 0.9rem;
		text-transform: none;
	}
	.meta div {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1rem;
	}
	.meta dt {
		color: var(--fg-3);
	}
	/* labels stay mono like the home page; values carry Korean, so they use the text face */
	.meta dd {
		margin: 0;
		color: var(--fg);
		font-family: var(--sans);
		font-size: 0.875rem;
		line-height: 1.6;
	}
	.meta .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	.meta a {
		color: var(--fg);
		background: linear-gradient(var(--accent-p), var(--accent-p)) 0 100% / 0 1px no-repeat;
		transition:
			background-size var(--t-fast) var(--ease-out),
			color var(--t-micro);
	}
	.meta a:hover {
		color: var(--accent-p);
		background-size: 100% 1px;
	}

	/* ---------- body: stacked topic bands (article/Section.astro); type rules for what the .mdx writes ---------- */
	.prose {
		counter-reset: sec;
		color: var(--fg-2);
		font-size: 1rem;
		line-height: 1.8;
	}
	.prose :global(.sec-text > *) {
		margin: 0;
	}
	.prose :global(.sec-text > * + *) {
		margin-top: 1.1rem;
	}
	.prose :global(.sec-text > .katex-display),
	.prose :global(.sec-text > .stats),
	.prose :global(.sec-text > pre) {
		margin-block: 1.75rem;
	}
	/* `<div class="stack">` in the copy: figures stacked inside one grid cell */
	.prose :global(.stack) {
		display: grid;
		gap: 0.75rem;
		align-content: start;
	}
	/* `<div class="pin-end">` in the copy: pushes that last block down so its bottom lines up with the end of a
	   taller picture column (the text column then stretches to the row and leaves the gap above it) */
	.prose :global(.sec-text:has(> .pin-end)) {
		align-self: stretch;
		display: flex;
		flex-direction: column;
	}
	.prose :global(.sec-text > .pin-end) {
		margin-top: auto;
		padding-top: 1.1rem;
	}
	/* `<div class="narrow">` in the copy: keeps a small figure group from filling the text column */
	.prose :global(.narrow) {
		max-width: 24rem;
	}
	/* `---` in the copy: a quiet divider between two parts of one topic */
	.prose :global(.sec-text > hr) {
		margin-block: 2rem;
		height: 1px;
		border: 0;
		background: color-mix(in srgb, var(--fg) 12%, transparent);
	}
	.prose :global(h2) {
		margin: 0 0 1.5rem;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: clamp(2rem, 4.2vw, 3rem);
		line-height: 1.05;
		color: var(--fg);
	}
	.prose :global(h2::before) {
		counter-increment: sec;
		content: counter(sec, decimal-leading-zero);
		display: block;
		margin-bottom: 0.75rem;
		font-family: var(--mono);
		font-size: 0.8rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--accent-p);
	}
	.prose :global(h3) {
		margin-top: 2.25rem;
		font-size: 1.1rem;
		font-weight: 650;
		letter-spacing: -0.01em;
		color: var(--fg);
	}
	.prose :global(strong) {
		color: var(--fg);
		font-weight: 650;
	}
	.prose :global(a) {
		color: var(--fg);
		text-decoration: underline;
		text-decoration-color: var(--accent-p);
		text-underline-offset: 0.2em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.2rem;
		display: grid;
		gap: 0.5rem;
	}
	.prose :global(ul > li::marker) {
		content: '▸  ';
		color: var(--accent-p);
	}
	.prose :global(ol > li::marker) {
		font-family: var(--mono);
		font-size: 0.8em;
		color: var(--accent-p);
	}
	.prose :global(code) {
		font-family: var(--mono);
		font-size: 0.85em;
		color: var(--fg);
	}
	.prose :global(pre) {
		padding: 1rem 1.25rem;
		border-radius: 6px;
		overflow-x: auto;
		font-size: 0.85rem;
		line-height: 1.6;
	}
	/* the before/after keeps its 16:9 at the full column width (its own 58vh cap is for the old screens) */
	.prose :global(.cmp .stage) {
		max-height: none;
	}
	.prose :global(.katex-display) {
		color: var(--fg);
		overflow-x: auto;
		overflow-y: hidden;
	}

	/* ---------- foot ---------- */
	.foot {
		width: min(100% - 2 * var(--pad), 80rem);
		margin: clamp(4rem, 10vh, 6rem) auto 0;
		display: grid;
		grid-template-columns: 1fr minmax(0, 26rem);
		gap: 2rem;
		align-items: end;
	}
	.back {
		color: var(--fg-2);
		text-transform: none;
	}
	.back:hover {
		color: var(--fg);
	}
	.next-card {
		display: grid;
		gap: 0.75rem;
		cursor: none;
	}
	.next-card > .mono {
		color: var(--fg-3);
		text-transform: none;
	}
	.next-card :global(.next-media) {
		aspect-ratio: 16 / 10;
		border-radius: 12px;
		border: 1px solid var(--line-2);
		/* hover outline = 1px border + 1px ring → 2px, without shifting the layout */
		box-shadow: 0 0 0 0 var(--accent-n);
		transition:
			border-color var(--t-fast),
			box-shadow var(--t-fast),
			transform var(--t-fast) var(--ease-out);
	}
	.next-card:hover :global(.next-media) {
		border-color: var(--accent-n);
		box-shadow: 0 0 0 1px var(--accent-n);
		transform: translateY(-4px);
	}
	.next-card strong {
		font-size: 1.5rem;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
	}

	/* ---------- lightbox ---------- */
	.lightbox {
		width: 100vw;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: clamp(1rem, 4vw, 3rem);
		border: 0;
		background: transparent;
		color: #fff;
	}
	.lightbox::backdrop {
		background: #000d;
		backdrop-filter: blur(6px);
	}
	.lightbox[open] {
		display: grid;
		place-items: center;
		animation: lb-in var(--t-fast) var(--ease-out);
	}
	@keyframes lb-in {
		from {
			opacity: 0;
			scale: 0.98;
		}
	}
	.lightbox figure {
		margin: 0;
		display: grid;
		gap: 0.75rem;
		justify-items: center;
		max-width: 100%;
		max-height: 100%;
		pointer-events: none;
	}
	.lightbox img {
		max-width: min(100%, 1600px);
		max-height: calc(100dvh - 8rem);
		object-fit: contain;
		border-radius: 6px;
		pointer-events: auto;
	}
	.lightbox figcaption {
		display: flex;
		gap: 1.5rem;
		font-size: 0.85rem;
		color: #ddd;
	}
	.lb-btn {
		all: unset;
		position: fixed;
		cursor: pointer;
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: #fff2;
		color: #fff;
		font-size: 1.1rem;
		transition: background-color var(--t-micro);
	}
	.lb-btn:hover,
	.lb-btn:focus-visible {
		background: #fff4;
	}
	.lb-btn:focus-visible {
		outline: 2px solid #fff;
	}
	.lb-prev {
		left: 1rem;
		top: 50%;
	}
	.lb-next {
		right: 1rem;
		top: 50%;
	}
	.lb-close {
		right: 1rem;
		top: 1rem;
	}

	@media (max-width: 900px) {
		.under,
		.foot {
			grid-template-columns: 1fr;
		}
		.hero {
			height: 56dvh;
		}
		h1 {
			font-size: clamp(2.25rem, 11vw, 4rem);
			overflow-wrap: anywhere;
		}
	}
</style>
