---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { site } from '../site';

const skills: [string, string[]][] = [
	['Shading', ['HLSL', 'DirectX 11']],
	['Programming', ['C', 'C++']],
	['Engine & DCC', ['Unreal Engine', 'Blender', '3ds Max', 'Photoshop']],
	['Tools', ['RenderDoc', 'ImGui', 'Git']],
];

const contacts = [
	{ label: 'GitHub', value: `@${site.handle}`, href: site.github },
	{ label: 'Notes', value: '공부 기록', href: '/notes/' },
	...(site.email ? [{ label: 'Email', value: site.email, href: `mailto:${site.email}` }] : []),
];
---

<PortfolioLayout title="About" current="about">
	<main class="about">
		<section class="statement">
			<p class="mono">About</p>
			<h1>
				{site.name}<span class="accent">.</span>
			</h1>
			<p class="role">{site.role} — {site.focus}</p>
			<p class="intro">{site.intro}</p>
		</section>

		<section class="side">
			<dl class="skills">
				{
					skills.map(([group, items], i) => (
						<div style={`--i: ${i}`}>
							<dt class="mono">{group}</dt>
							<dd>{items.join(' · ')}</dd>
						</div>
					))
				}
			</dl>
			<ul class="contacts">
				{
					contacts.map((c) => (
						<li>
							<a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
								<span class="mono">{c.label}</span>
								<span>{c.value} ↗</span>
							</a>
						</li>
					))
				}
			</ul>
		</section>
	</main>
</PortfolioLayout>

<style>
	.about {
		height: 100dvh;
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: clamp(2rem, 7vw, 7rem);
		align-items: center;
		padding: calc(var(--nav-h) + 1rem) var(--pad) var(--pad);
		max-width: 90rem;
		margin-inline: auto;
	}
	.statement .mono {
		margin: 0 0 1rem;
		color: var(--accent);
	}
	h1 {
		margin: 0;
		font-size: clamp(3rem, 11vh, 7.5rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 0.95;
	}
	.accent {
		color: var(--accent);
	}
	.role {
		margin: 1.25rem 0 0;
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--fg-2);
	}
	.intro {
		margin: 1.5rem 0 0;
		max-width: 34rem;
		white-space: pre-line;
		font-size: clamp(1rem, 2.2vh, 1.25rem);
		line-height: 1.7;
		color: var(--fg);
	}
	.skills {
		margin: 0;
		border-top: 1px solid var(--line-2);
	}
	.skills div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--line-2);
		animation: rise var(--t-page) var(--ease-out) both;
		animation-delay: calc(var(--i) * 50ms + 100ms);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	.skills dd {
		margin: 0;
		color: var(--fg-2);
		font-size: 0.9375rem;
	}
	.contacts {
		list-style: none;
		margin: 2rem 0 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	.contacts a {
		display: flex;
		justify-content: space-between;
		padding: 0.9rem 1rem;
		border: 1px solid var(--line-2);
		border-radius: 10px;
		transition:
			border-color var(--t-micro),
			background-color var(--t-micro),
			padding var(--t-fast) var(--ease-out);
	}
	.contacts a:hover {
		border-color: var(--accent);
		background: var(--bg-2);
		padding-inline: 1.25rem 1rem;
	}
	@media (max-width: 820px) {
		:global(body) {
			overflow: auto;
		}
		.about {
			height: auto;
			min-height: 100dvh;
			grid-template-columns: 1fr;
		}
	}
</style>
