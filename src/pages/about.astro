---
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import { site, mailData } from '../site';

const skills: [string, string[]][] = [
	['Shading', ['HLSL', 'DirectX 11']],
	['Programming', ['C', 'C++']],
	['Engine & DCC', ['Unreal Engine', 'Blender', '3ds Max', 'Photoshop']],
	['Tools', ['RenderDoc', 'ImGui', 'Git']],
];

// GitHub, Email (copies the address), Notes
const contacts = [
	{ label: 'GitHub', value: `@${site.handle}`, href: site.github },
	...(site.email ? [{ label: 'Email', value: '', href: '' }] : []),
	{ label: 'Notes', value: '기록', href: '/notes/' },
];
---

<PortfolioLayout title="About" current="about">
	<main class="about">
		<!-- arch portrait, framed like the Figma portfolio slide (cut above the legs), mirrored to face the text -->
		<img
			class="portrait"
			src="/images/about/portrait-arch45-640.webp"
			srcset="/images/about/portrait-arch45-640.webp 640w, /images/about/portrait-arch45-1280.webp 1280w"
			sizes="(max-width: 820px) min(64vw, 17rem), clamp(16rem, 40dvh, 24rem)"
			width="1280"
			height="1600"
			alt={`${site.name} 프로필 사진`}
			decoding="async"
		/>

		<div class="text">
			<section class="statement">
				<p class="mono">About</p>
				<h1>
					{site.name}<span class="accent">.</span>
				</h1>
				<p class="role">{site.role} — {site.focus}</p>
				<p class="intro">{site.intro}</p>
			</section>

			<section class="side">
				<dl class="skills">
					{
						skills.map(([group, items], i) => (
							<div style={`--i: ${i}`}>
								<dt class="mono">{group}</dt>
								<dd>{items.join(' · ')}</dd>
							</div>
						))
					}
				</dl>
				<ul class="contacts">
					{
						contacts.map((c) => (
							<li>
								{c.label === 'Email' ? (
									<button class="copy" type="button" data-mail={mailData} aria-label="이메일 주소 복사">
										<span class="mono">Email</span>
										<span class="value">
											<span class="idle">
												<span data-mail-text>…</span> ⧉
											</span>
											<span class="done">복사됨 ✓</span>
										</span>
									</button>
								) : (
									<a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
										<span class="mono">{c.label}</span>
										<span>{c.value} ↗</span>
									</a>
								)}
							</li>
						))
					}
				</ul>
			</section>
		</div>
	</main>
</PortfolioLayout>

<script>
	import { initCopyEmail } from '../scripts/copy-email';
	initCopyEmail();
</script>

<style>
	/* arch portrait on the left; name, intro, skills and contacts stacked as one block on the right */
	.about {
		min-height: 100vh;
		min-height: 100dvh;
		display: grid;
		grid-template-columns: auto minmax(0, 36rem);
		justify-content: center;
		align-content: center;
		align-items: start;
		column-gap: clamp(2.5rem, 6vw, 6rem);
		padding: calc(var(--nav-h) + 1rem) var(--pad) var(--pad);
		max-width: 76rem;
		margin-inline: auto;
		--name-size: clamp(2.75rem, min(8vh, 4.6vw), 5rem);
	}
	/* short desktop windows: let the page scroll instead of clipping (portfolio.css locks body scrolling) */
	:global(body:has(main.about)) {
		overflow-y: auto;
	}
	/* 4:5, framed like the Figma portfolio slide; sized by screen height so it fits next to the text.
	   The arch's top sits level with the top of the name's capitals: pushed down by the "About" label's line, its margin,
	   and the gap between the name's line box and its cap height (~0.075em). */
	.portrait {
		height: clamp(20rem, 50dvh, 30rem);
		width: auto;
		margin-top: calc(0.75rem * 1.5 + 1rem + var(--name-size) * 0.075);
		aspect-ratio: 4 / 5;
		object-fit: cover;
		border-radius: 999px 999px 14px 14px;
		background: var(--bg-2);
	}
	.text {
		display: grid;
		gap: 2.25rem;
	}
	.statement .mono {
		margin: 0 0 1rem;
		line-height: 1.5;
		color: var(--accent);
	}
	/* first and last name always stay on one line */
	h1 {
		margin: 0;
		white-space: nowrap;
		font-size: var(--name-size);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 0.95;
	}
	.accent {
		color: var(--accent);
	}
	.role {
		margin: 1.1rem 0 0;
		font-family: var(--mono);
		font-size: 0.875rem;
		color: var(--fg-2);
	}
	.intro {
		margin: 1.25rem 0 0;
		white-space: pre-line;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--fg);
	}
	.skills {
		margin: 0;
		border-top: 1px solid var(--line-2);
	}
	.skills div {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 1rem;
		padding: 0.8rem 0;
		border-bottom: 1px solid var(--line-2);
		animation: rise var(--t-page) var(--ease-out) both;
		animation-delay: calc(var(--i) * 50ms + 100ms);
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
		}
	}
	.skills dd {
		margin: 0;
		color: var(--fg-2);
		font-size: 0.9375rem;
	}
	/* three cards in a row; the email card takes the width its address needs */
	.contacts {
		list-style: none;
		margin: 1.5rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		gap: 0.5rem;
	}
	.contacts a,
	.contacts .copy {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		height: 100%;
		padding: 0.8rem 1rem;
		border: 1px solid var(--line-2);
		border-radius: 10px;
		font-size: 0.875rem;
		white-space: nowrap;
		transition:
			border-color var(--t-micro),
			background-color var(--t-micro);
	}
	.contacts a:hover,
	.contacts .copy:hover {
		border-color: var(--accent);
		background: var(--bg-2);
	}
	.contacts .copy {
		width: 100%;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.875rem;
		text-align: left;
		cursor: pointer;
	}
	.copy .done,
	.copy.copied .idle {
		display: none;
	}
	.copy.copied .done {
		display: inline;
		color: var(--accent);
	}
	.copy.copied {
		border-color: var(--accent);
	}
	/* phones / narrow: arch on top, then the text block; contacts as a list (body scrolling comes from portfolio.css) */
	@media (max-width: 820px) {
		.about {
			grid-template-columns: minmax(0, 1fr);
			align-content: start;
			row-gap: 2rem;
			padding-bottom: calc(var(--pad) + 1rem + env(safe-area-inset-bottom, 0px));
		}
		.portrait {
			height: auto;
			width: min(64vw, 17rem);
			margin-top: 0;
		}
		h1 {
			font-size: clamp(2.5rem, 13vw, 4.5rem);
		}
		.contacts {
			grid-template-columns: minmax(0, 1fr);
		}
		.contacts a,
		.contacts .copy {
			flex-direction: row;
			justify-content: space-between;
			font-size: 1rem;
		}
	}
</style>
