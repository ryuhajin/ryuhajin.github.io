---
// Devlog: one foldable block per project. In Progress blocks start open, with the latest entry opened (text + two
// pictures) and the earlier ones as rows; Complete blocks start folded. Each block shows 4 items a page (the opened
// latest entry counts as one) with 1 2 3 … below; the Complete list itself pages 5 projects at a time.
// Entries: src/content/devlog/.
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import LogList from '../../components/portfolio/devlog/LogList.astro';
import { devlogBlocks, getDevlogs, entryUrl, fmtDate, pad } from '../../portfolio/devlog';

const PER_PAGE = 4;
const SERIES_PER_PAGE = 5;
const total = (await getDevlogs()).length;
const { inProgress, complete } = await devlogBlocks();
const span = (dates: Date[]) => {
	const [a, b] = [Math.min(...dates.map(Number)), Math.max(...dates.map(Number))].map((t) => fmtDate(new Date(t)).slice(0, 7));
	return a === b ? a : `${a} – ${b}`;
};
---

<PortfolioLayout title="Devlog" description="진행 중인 작업의 개발 기록" current="devlog">
	<main class="devlog">
		<h1>
			Devlog <sup class="mono">({pad(total)})</sup>
		</h1>

		<section aria-labelledby="in-progress">
			<h2 id="in-progress" class="mono sec">
				<svg class="sec-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="3" cy="8" r="1.3" /><circle cx="8" cy="8" r="1.3" /><circle cx="13" cy="8" r="1.3" /></svg>
				In progress <span>({pad(inProgress.length)})</span>
			</h2>
			{
				inProgress.map(({ project, entries }) => {
					const [latest, ...earlier] = entries;
					const pics = latest?.data.images.length ? latest.data.images : [{ src: project.data.cover.poster, alt: project.data.cover.alt }];
					return (
						<details class="series live" id={project.id} open style={`--accent-p: ${project.data.accent}`}>
							<summary>
								<span class="name">{project.data.title}</span>
								<span class="mono">{pad(entries.length)} logs</span>
								<span class="fold" aria-hidden="true" />
							</summary>
							<div class="series-body" data-paged data-per={PER_PAGE}>
								<div class="entries">
									{latest ? (
										<div class="open" data-page-item>
											<a href={entryUrl(latest)} class="open-row">
												<span class="no">#{pad(latest.data.part)}</span>
												<span class="t">{latest.data.title}</span>
												<span class="mono date">{fmtDate(latest.data.date)}</span>
											</a>
											<div class="open-body">
												<div class="open-text">
													<p>{latest.data.summary}</p>
													<a href={entryUrl(latest)} class="explore">
														Explore →
													</a>
												</div>
												<div class:list={['open-media', { single: pics.length === 1 }]}>
													{pics.map((im) => (
														<img src={im.src} alt={im.alt} loading="lazy" decoding="async" />
													))}
												</div>
											</div>
										</div>
									) : (
										<p class="empty mono">No logs yet</p>
									)}
									{earlier.length > 0 && <LogList entries={earlier} fallback={project.data.cover.poster} accent={project.data.accent} />}
								</div>
								<nav class="pager mono" aria-label={`${project.data.title} 목록 페이지`} data-pager hidden />
							</div>
						</details>
					);
				})
			}
		</section>

		{
			complete.length > 0 && (
				<section aria-labelledby="complete" data-paged data-per={SERIES_PER_PAGE}>
					<h2 id="complete" class="mono sec">
						<svg class="sec-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8.5 6.2 12 13.5 4.2" /></svg>
						Complete <span>({pad(complete.length)})</span>
					</h2>
					{complete.map(({ project, entries }) => (
						<details class="series done" id={project.id} style={`--accent-p: ${project.data.accent}`} data-page-item>
							<summary>
								<span class="name">{project.data.title}</span>
								<span class="mono meta">
									<span class="meta-logs">{entries.length} logs</span>
									<span class="meta-date">{span(entries.map((e) => e.data.date))}</span>
								</span>
								<span class="fold" aria-hidden="true" />
							</summary>
							<div class="series-body" data-paged data-per={PER_PAGE}>
								<div class="entries">
									<LogList entries={entries} fallback={project.data.cover.poster} accent={project.data.accent} />
								</div>
								<nav class="pager mono" aria-label={`${project.data.title} 목록 페이지`} data-pager hidden />
							</div>
						</details>
					))}
					<nav class="pager series-pager mono" aria-label="Complete 프로젝트 페이지" data-pager data-steps hidden />
				</section>
			)
		}
	</main>

	<div class="follow" data-follow aria-hidden="true">
		<img alt="" />
		<video muted loop playsinline hidden></video>
	</div>
</PortfolioLayout>

<script>
	import { initHoverMedia } from '../../scripts/portfolio/hover-media';
	import { initPagers } from '../../scripts/portfolio/pager';
	initHoverMedia();
	initPagers();
	// a #project link (from a project page) opens a folded series, turning the Complete list to its page first
	const target = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1)));
	if (target instanceof HTMLDetailsElement) {
		if (target.hidden) {
			const series = [...target.parentElement!.querySelectorAll(':scope > details')];
			const per = Number(target.parentElement!.dataset.per) || 5;
			target.parentElement!.querySelectorAll<HTMLButtonElement>(':scope > [data-pager] .pg-num')[Math.floor(series.indexOf(target) / per)]?.click();
		}
		target.open = true;
		target.scrollIntoView({ block: 'start' });
	}
</script>

<style>
	:global(body:has(main.devlog)) {
		overflow: auto;
	}
	.devlog {
		/* shared with LogList.astro: part-number column, row title size, and the one colour of numbers + dates */
		--no-w: 4.5rem;
		--row-t: clamp(1.1rem, 2.4vh, 1.375rem);
		--meta: color-mix(in srgb, var(--fg-2), var(--fg-3));
		--meta-font: var(--sans);
		padding: calc(var(--nav-h) + clamp(2.5rem, 8vh, 5.5rem)) var(--gutter) clamp(4rem, 10vh, 6rem);
	}
	/* meta text on this page is the code face, as written, not upper-cased */
	.devlog :global(.mono) {
		font-family: var(--meta-font);
		font-size: 0.8125rem;
		letter-spacing: 0;
		text-transform: none;
	}
	h1 {
		margin: 0 0 var(--head-gap);
		font-size: clamp(1.75rem, 4.5vh, 3rem);
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		line-height: 1;
	}
	h1 sup,
	.sec span {
		font-size: 0.8rem;
		vertical-align: top;
		color: var(--fg-3);
	}
	.sec {
		margin: 0 0 1.5rem;
		color: var(--fg-2);
	}
	/* section mark: ⋯ for in progress, ✓ for complete */
	.sec {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.sec-icon {
		flex: none;
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.75;
		stroke-linecap: square;
	}
	.sec-icon circle {
		fill: currentColor;
		stroke: none;
	}
	section + section {
		margin-top: clamp(4rem, 12vh, 7rem);
	}

	/* ---------- one series = one <details> ---------- */
	.series {
		scroll-margin-top: calc(var(--nav-h) + 2rem);
	}
	:global(.devlog [data-page-item]) {
		scroll-margin-top: 0; /* root scroll-padding provides the fixed-header offset */
	}
	.series summary {
		list-style: none;
		cursor: pointer;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
	}
	.series summary::-webkit-details-marker {
		display: none;
	}
	.series summary .mono {
		color: var(--fg-2);
	}
	/* Complete: log count over the period, right-aligned */
	.meta {
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.2rem;
		line-height: 1.2;
	}
	.series summary .meta-logs {
		color: var(--fg-3);
		font-size: 0.75rem;
	}
	.series summary .meta-date {
		color: var(--fg-2);
		font-size: 0.875rem;
	}
	.name {
		margin-right: auto;
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: clamp(1.75rem, 4.4vh, 2.75rem);
		line-height: 1.05;
		color: var(--fg);
	}
	.series summary:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
	}

	/* fold chevron: points down while closed, up once open */
	.fold {
		position: relative;
		align-self: center;
		width: 1.75rem;
		height: 1.75rem;
		border: 2px solid var(--line-2);
		transition: border-color var(--t-fast);
	}
	.fold::before {
		content: '';
		position: absolute;
		left: 50%;
		top: 50%;
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid var(--fg-2);
		border-bottom: 2px solid var(--fg-2);
		translate: -50% -70%;
		rotate: 45deg;
		transition:
			rotate var(--t-fast) var(--ease-out),
			translate var(--t-fast) var(--ease-out);
	}
	.series[open] > summary .fold::before {
		rotate: 225deg;
		translate: -50% -30%;
	}
	.series summary:hover .fold {
		border-color: var(--fg);
	}

	/* In Progress: a header line over the opened entry */
	.live + .live {
		margin-top: clamp(3rem, 9vh, 5rem);
	}
	/* folded series sit close together, like the Complete lines */
	.live:not([open]) + .live {
		margin-top: 1.5rem;
	}
	/* every rule on the page is one weight: 2px */
	.live summary {
		padding-bottom: 0.75rem;
		border-bottom: 2px solid transparent;
		transition: border-color var(--t-fast) var(--ease);
	}
	.live:not([open]) summary {
		padding-bottom: 1rem;
		border-bottom-color: var(--line-2);
	}
	.live:not([open]) summary:hover {
		border-bottom-color: var(--fg);
	}

	/* Complete: one folded line per series */
	.done summary {
		padding: clamp(0.7rem, 2vh, 1.15rem) 0.25rem;
		border-top: 2px solid var(--line-2);
		transition: border-color var(--t-fast) var(--ease);
	}
	/* the last line closes with a bottom rule: last in the list, or last on the current page */
	.done:is(:last-of-type, [data-page-last]):not([open]) summary {
		border-bottom: 2px solid var(--line-2);
	}
	.done summary:hover {
		border-top-color: var(--fg);
	}
	.done:is(:last-of-type, [data-page-last]):not([open]) summary:hover {
		border-bottom-color: var(--fg);
	}
	/* a folded line's bottom rule is the next series' top rule: light it with the hovered one */
	:global(.devlog .done:not([open]):has(> summary:hover) + .done > summary) {
		border-top-color: var(--fg);
	}
	/* an opened header lights the rule under it too (the first shown item's top rule), as it does while folded */
	:global(.devlog .series[open]:has(> summary:hover) .open[data-page-first]),
	:global(.devlog .series[open]:has(> summary:hover) [data-page-first] > .row) {
		border-top-color: var(--fg);
	}
	.done .series-body {
		padding-top: 0.25rem;
	}
	/* the page numbers sit in a fixed footer that stays (empty) when there is one page,
	   so every opened series ends with the same gap before the next one */
	.done .pager,
	.done .pager[hidden] {
		display: flex;
		align-items: flex-start;
		box-sizing: border-box;
		height: 4.5rem;
		margin-top: 0;
		padding-top: 1rem;
	}
	.done .pager[hidden] {
		visibility: hidden;
	}

	/* the closing rule belongs to the list, so a paged-out last row never takes it away */
	.entries {
		border-bottom: 2px solid var(--line-2);
		transition: border-color var(--t-fast) var(--ease);
	}
	/* hovering the last row on the page lights its bottom rule too, like every other row's pair of rules */
	/* global: the rows come from LogList.astro, so they don't carry this page's scope */
	:global(.devlog .entries:has([data-page-last] > .row:hover)) {
		border-bottom-color: var(--fg);
	}
	.entries > [hidden] {
		display: none;
	}
	.empty {
		margin: 0;
		padding: 1.25rem 0.25rem;
		border-top: 2px solid var(--line-2);
		color: var(--fg-3);
	}

	/* latest entry, opened: the row (#NN · title · date, as LogList), then text + two pictures */
	.open {
		border-top: 2px solid var(--line-2);
		transition: border-color var(--t-fast) var(--ease);
	}
	.open-row {
		--open-t: clamp(1.5rem, 3.4vh, 2rem);
		display: grid;
		grid-template-columns: var(--no-w) minmax(0, 1fr) 6.5rem;
		align-items: baseline;
		gap: 1rem;
		padding: clamp(0.75rem, 1.7vh, 1rem) 0.25rem;
	}
	.open-row .no {
		font-family: var(--meta-font);
		font-size: calc(var(--open-t) * 0.8);
		font-variant-numeric: tabular-nums;
		color: var(--meta);
	}
	.open-row .t {
		font-family: var(--font-display);
		font-weight: var(--display-weight);
		letter-spacing: var(--display-tracking);
		font-size: var(--open-t);
		line-height: 1.15;
	}
	.open-row:hover .t {
		color: var(--accent-p);
	}
	.open-row .date {
		color: var(--meta);
		text-align: right;
	}
	.open-body {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		padding: clamp(0.5rem, 2vh, 1.25rem) 0.25rem clamp(1.75rem, 5vh, 3rem) calc(var(--no-w) + 1.25rem);
	}
	.open-text p {
		margin: 0;
		max-width: 34rem;
		color: var(--fg);
		font-size: clamp(1rem, 2.2vh, 1.2rem);
		line-height: 1.7;
	}
	/* the text column stacks the summary and, at its right edge, a square Explore button */
	.open-text {
		display: flex;
		flex-direction: column;
	}
	.explore {
		align-self: flex-end;
		margin-top: 1.5rem;
		padding: 0.65rem 1.4rem;
		border: 2px solid var(--fg);
		color: var(--fg);
		font-weight: 600;
		transition:
			background-color var(--t-fast) var(--ease),
			color var(--t-fast) var(--ease),
			border-color var(--t-fast) var(--ease);
	}
	.explore:hover,
	.explore:focus-visible {
		background: var(--accent-p);
		border-color: var(--accent-p);
		color: var(--bg);
	}
	.open-media {
		display: grid;
		grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
		gap: 10px;
		aspect-ratio: 2.4;
	}
	.open-media.single {
		grid-template-columns: 1fr;
	}
	.open-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: var(--bg-2);
	}

	/* page numbers under a series */
	.pager {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.25rem;
		margin-top: 1rem;
	}
	.pager[hidden] {
		display: none;
	}
	.pager :global(button) {
		all: unset;
		cursor: pointer;
		min-width: 2rem;
		padding: 0.3rem 0.2rem;
		text-align: center;
		color: var(--fg-3);
		transition: color var(--t-micro);
	}
	.pager :global(button:hover) {
		color: var(--fg-2);
	}
	/* current page: brighter and bolder, no underline */
	.pager :global(button[aria-current='true']) {
		color: var(--fg);
		font-weight: 700;
	}
	.pager :global(button:focus-visible) {
		outline: 2px solid var(--accent);
	}

	/* the Complete list's own pager reads apart from a project's centred 1 2 3:
	   "Page 01 / 02" on the left, ← 1 2 → on the right, a bar under each number */
	.series-pager {
		justify-content: flex-end;
		align-items: center;
		margin-top: 2rem;
	}
	.series-pager :global(.pg-count) {
		margin-right: auto;
		color: var(--fg-2);
		font-variant-numeric: tabular-nums;
	}
	.series-pager :global(.pg-count)::before {
		content: 'Page ';
		color: var(--fg-3);
	}
	.series-pager :global(.pg-num) {
		position: relative;
		padding-bottom: 0.6rem;
	}
	.series-pager :global(.pg-num)::after {
		content: '';
		position: absolute;
		left: 0.35rem;
		right: 0.35rem;
		bottom: 0;
		height: 2px;
		background: var(--line-2);
		transition: background-color var(--t-fast) var(--ease);
	}
	.series-pager :global(.pg-num:hover)::after {
		background: var(--fg-3);
	}
	.series-pager :global(.pg-num[aria-current='true'])::after {
		background: var(--fg);
	}
	.series-pager :global(.pg-prev),
	.series-pager :global(.pg-next) {
		padding-bottom: 0.6rem;
		color: var(--fg-2);
	}
	.series-pager :global(.pg-prev:disabled),
	.series-pager :global(.pg-next:disabled) {
		opacity: 0.3;
		cursor: default;
	}

	/* cursor preview for the rows (hover-media.ts) — square */
	.follow {
		position: fixed;
		left: 0;
		top: 0;
		z-index: 40;
		width: clamp(9.6rem, 15.6vw, 14.4rem);
		aspect-ratio: 16 / 10;
		overflow: hidden;
		pointer-events: none;
		opacity: 0;
		scale: 0.6;
		transition:
			opacity var(--t-fast) var(--ease),
			scale var(--t-fast) var(--ease-out);
		box-shadow: 0 30px 60px -20px #000;
	}
	.follow:global(.show) {
		opacity: 1;
		scale: 1;
	}
	.follow img,
	.follow video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.follow video[hidden] {
		display: none;
	}
	@media (hover: none), (pointer: coarse) {
		.follow {
			display: none;
		}
	}

	@media (max-width: 820px), (max-width: 1024px) and (max-height: 500px) {
		.devlog {
			--no-w: 3.25rem;
			--row-t: clamp(1.15rem, 5vw, 1.4rem);
		}
		h1 {
			font-size: clamp(2rem, 9vw, 2.75rem);
		}
		.follow {
			display: none;
		}
		.pager :global(button) {
			box-sizing: border-box;
			min-width: 44px;
			min-height: 44px;
		}
		.open-row,
		.explore {
			min-height: 44px;
		}
		.open-row {
			--open-t: clamp(1.25rem, 6vw, 1.6rem);
			grid-template-columns: var(--no-w) minmax(0, 1fr);
			gap: 0.2rem 0.75rem;
		}
		.open-row .t {
			overflow-wrap: anywhere;
		}
		.open-row .date {
			grid-column: 2;
			text-align: left;
		}
		.open-body {
			grid-template-columns: minmax(0, 1fr);
			padding-left: 0.25rem;
		}
		.open-media {
			aspect-ratio: 16 / 9;
		}
		.series summary {
			gap: 0.25rem 1rem;
			min-height: 44px;
		}
		.name {
			flex-basis: calc(100% - 3rem);
		}
		.name {
			font-size: clamp(1.5rem, 7vw, 2rem);
		}
		/* under the name on a phone, so it lines up left */
		.meta {
			align-items: flex-start;
		}
		/* the chevron stays at the top-right corner while the meta wraps under the name */
		.fold {
			position: absolute;
			right: 0.25rem;
			top: 0;
			width: 44px;
			height: 44px;
		}
		.series summary {
			position: relative;
			padding-right: 3.5rem;
		}
	}
</style>
