---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteNav from '../components/portfolio/SiteNav.astro';
import HeroShapes from '../components/portfolio/HeroShapes.astro';
import CornerWave from '../components/portfolio/CornerWave.astro';
import Brand from '../components/shared/Brand.astro';
import { site, nav } from '../site';

const projects = await getCollection('projects');

// hover images per menu: every image in public/trail/<menu-id>/
const trails = Object.fromEntries(
	nav.map(({ id }) => {
		const dir = `public/trail/${id}`;
		const files = fs.existsSync(dir) ? fs.readdirSync(dir).filter((f) => /\.(webp|png|jpe?g|avif|gif|svg)$/i.test(f)) : [];
		return [id, files.sort().map((f) => `/trail/${id}/${encodeURIComponent(f)}`)];
	})
);
---

<PortfolioLayout bar={false}>
	<main class="home">
		<HeroShapes />
		<CornerWave />

		<header class="top">
			<Brand />
		</header>

		<section class="menu">
			<p class="kicker mono">{site.role} — {site.focus}</p>
			<SiteNav mode="hero" trails={trails} />
		</section>

		<footer class="bottom">
			<p class="intro">{site.intro}</p>
			<dl class="meta mono">
				<div><dt>Based</dt><dd>{site.location}</dd></div>
				<div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
				<div><dt>Projects</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
			</dl>
		</footer>
	</main>
	<div id="trail-layer" aria-hidden="true"></div>
</PortfolioLayout>

<script>
	import { initCursorTrail } from '../scripts/portfolio/cursor-trail';
	import { initHeroShapes } from '../scripts/portfolio/hero-shapes';

	initCursorTrail();
	initHeroShapes();

	const clock = document.querySelector<HTMLElement>('[data-clock]');
	if (clock) {
		const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Seoul' });
		const tick = () => (clock.textContent = `${fmt.format(new Date())} KST`);
		tick();
		setInterval(tick, 1000);
	}
</script>

<style>
	.home {
		position: relative;
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: calc(var(--pad) * 0.75) var(--pad) var(--pad);
		overflow: hidden;
	}
	.top,
	.menu,
	.bottom {
		position: relative;
		z-index: 1;
	}
	.top {
		display: flex;
		align-items: center;
		height: calc(var(--nav-h) - var(--pad) * 0.75);
	}

	.menu {
		align-self: center;
		display: grid;
		gap: clamp(1rem, 3vh, 2rem);
		width: fit-content;
		max-width: 100%;
	}
	.kicker {
		margin: 0;
		color: var(--fg-2);
		text-transform: none;
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 2rem;
		border-top: 1px solid var(--line);
		padding-top: 1.25rem;
		background: linear-gradient(to top, var(--bg) 40%, transparent);
	}
	.intro {
		margin: 0;
		max-width: 34rem;
		color: var(--fg-2);
		font-size: 0.9375rem;
		line-height: 1.7;
	}
	.meta {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
		margin: 0;
	}
	.meta dt {
		color: var(--fg-3);
		margin-bottom: 0.3rem;
	}
	.meta dd {
		margin: 0;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.bottom {
			flex-direction: column;
			align-items: start;
		}
		.intro {
			font-size: 0.875rem;
		}
	}

	/* hover images (layer below the menu text) */
	#trail-layer {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}
	:global(.trail-obj) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate3d(var(--x), var(--y), 0) translate(-50%, -50%) rotate(var(--r)) scale(calc(var(--s) * 0.88));
		opacity: 0;
		filter: blur(8px);
		transition:
			transform 520ms cubic-bezier(0.16, 1, 0.3, 1),
			opacity 460ms cubic-bezier(0.25, 1, 0.5, 1),
			filter 460ms cubic-bezier(0.25, 1, 0.5, 1);
		will-change: transform, opacity, filter;
	}
	:global(.trail-obj.in) {
		transform: translate3d(var(--x), var(--y), 0) translate(-50%, -50%) rotate(var(--r)) scale(var(--s));
		opacity: 1;
		filter: blur(0);
	}
	:global(.trail-obj.out) {
		transform: translate3d(var(--x), calc(var(--y) - 24px), 0) translate(-50%, -50%) rotate(var(--r)) scale(calc(var(--s) * 0.94));
		opacity: 0;
		filter: blur(4px);
		transition-duration: 720ms, 720ms, 720ms;
		transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
	}
	:global(.trail-obj img) {
		width: clamp(10rem, 15vw, 15rem);
		height: auto;
		filter: drop-shadow(0 18px 24px rgb(0 0 0 / 0.35));
	}
</style>
