---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteNav from '../components/portfolio/SiteNav.astro';
import HeroShapes from '../components/portfolio/HeroShapes.astro';
import CornerWave from '../components/portfolio/CornerWave.astro';
import Brand from '../components/shared/Brand.astro';
import { site } from '../site';
import { hoverSets } from '../portfolio/hover-sets';

const projects = await getCollection('projects');

---

<PortfolioLayout bar={false}>
	<main class="home">
		<!-- decoration stage: everything above the bottom bar, clipped so nothing runs into it -->
		<div class="stage" aria-hidden="true">
			<CornerWave />
			<HeroShapes />
			<svg class="corner-tri" viewBox="0 0 100 84" preserveAspectRatio="none"><polygon points="0,84 100,0 100,84"></polygon></svg>
		</div>

		<header class="top">
			<Brand />
		</header>

		<section class="menu">
			<p class="kicker mono">{site.role} — {site.focus}</p>
			<SiteNav mode="hero" hoverSets={hoverSets} />
		</section>

		<footer class="bottom">
			<p class="intro">{site.intro}</p>
			<dl class="meta mono">
				<div><dt>Based</dt><dd>{site.location}</dd></div>
				<div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
				<div><dt>Projects</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
			</dl>
		</footer>
	</main>
	<div id="trail-layer" aria-hidden="true"></div>
</PortfolioLayout>

<script>
	import { initCursorTrail } from '../scripts/portfolio/cursor-trail';
	import { initHeroShapes } from '../scripts/portfolio/hero-shapes';

	initCursorTrail();
	initHeroShapes();

	const clock = document.querySelector<HTMLElement>('[data-clock]');
	if (clock) {
		const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Seoul' });
		const tick = () => (clock.textContent = `${fmt.format(new Date())} KST`);
		tick();
		setInterval(tick, 1000);
	}
</script>

<style>
	.home {
		position: relative;
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: calc(var(--pad) * 0.75) var(--pad) var(--pad);
		overflow: hidden;
	}
	.top,
	.menu,
	.bottom {
		position: relative;
		z-index: 1;
	}
	.top {
		grid-row: 1;
		grid-column: 1;
	}
	.menu {
		grid-row: 2;
		grid-column: 1;
	}
	.stage {
		grid-row: 1 / 3;
		grid-column: 1;
		position: relative;
		z-index: 0;
		overflow: hidden;
		pointer-events: none;
		/* bleed to the top and right edges of the screen, stop at the bottom bar */
		margin: calc(var(--pad) * -0.75) calc(var(--pad) * -1) 0.75rem;
	}
	/* upright right triangle against the right edge, right angle bottom-right */
	.corner-tri {
		position: absolute;
		right: 0;
		bottom: 0;
		width: clamp(12rem, 24vw, 30rem);
		aspect-ratio: 100 / 84;
		fill: var(--shape-fill);
		opacity: 0.9;
	}
	:global(:root:is([data-ptheme=space], [data-ptheme=candy], [data-ptheme=gameboy])) .corner-tri {
		display: none;
	}
	.top {
		display: flex;
		align-items: center;
		height: calc(var(--nav-h) - var(--pad) * 0.75);
	}

	.menu {
		align-self: center;
		display: grid;
		gap: clamp(1rem, 3vh, 2rem);
		width: fit-content;
		max-width: 100%;
	}
	.kicker {
		margin: 0;
		color: var(--fg-2);
		text-transform: none;
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 2rem;
		border-top: 1px solid var(--line);
		padding-top: 1.25rem;
		background: linear-gradient(to top, var(--bg) 40%, transparent);
	}
	.intro {
		margin: 0;
		max-width: 34rem;
		color: var(--fg-2);
		font-size: 0.9375rem;
		line-height: 1.7;
	}
	.meta {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
		margin: 0;
	}
	.meta dt {
		color: var(--fg-3);
		margin-bottom: 0.3rem;
	}
	.meta dd {
		margin: 0;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.bottom {
			flex-direction: column;
			align-items: start;
		}
		.intro {
			font-size: 0.875rem;
		}
	}

	/* hover image compositions (layer below the menu text) */
	#trail-layer {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}
	:global(.hover-cluster img) {
		position: absolute;
		left: 0;
		top: 0;
		width: var(--w);
		height: auto;
		transform: translate(-50%, -50%) rotate(var(--r)) scale(0.9);
		opacity: 0;
		filter: blur(8px) drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
		transition:
			opacity 700ms cubic-bezier(0.4, 0, 0.2, 1),
			filter 700ms cubic-bezier(0.4, 0, 0.2, 1),
			transform 800ms cubic-bezier(0.16, 1, 0.3, 1);
		will-change: translate, opacity;
	}
	:global(.hover-cluster.show img) {
		opacity: 1;
		filter: blur(0) drop-shadow(0 18px 22px rgb(0 0 0 / 0.35));
		transform: translate(-50%, -50%) rotate(var(--r)) scale(1);
		transition-duration: 520ms, 520ms, 620ms;
		transition-delay: calc(var(--i) * 60ms);
	}
</style>
