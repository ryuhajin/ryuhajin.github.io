---
import { getCollection } from 'astro:content';
import PortfolioLayout from '../layouts/PortfolioLayout.astro';
import SiteNav from '../components/portfolio/SiteNav.astro';
import { site } from '../site';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const trails = {
	projects: projects.map((p) => ({ img: p.data.cover.poster })),
	notes: ['float4', 'SV_Target', 'lerp(a, b, t)', 'M·V·P', 'N·L', 'Nanite', '∂f/∂x', 'SListView', 'cbuffer'].map((text) => ({ text })),
	about: ['C++', 'HLSL', 'UE5', 'DX11', 'Blender', 'RenderDoc'].map((text) => ({ text })),
	github: ['git push', 'main', '+128 −42', 'PR #12', 'commit a1f3c9e'].map((text) => ({ text })),
};
---

<PortfolioLayout bar={false}>
	<main class="home">
		<header class="top">
			<a href="/" class="brand" transition:name="brand"><span class="dot"></span>{site.handle}</a>
			<div class="status mono">
				<span class="pulse" aria-hidden="true"></span>{site.status}
			</div>
		</header>

		<section class="menu">
			<p class="kicker mono">{site.role} — {site.focus}</p>
			<SiteNav mode="hero" trails={trails} />
		</section>

		<footer class="bottom">
			<p class="intro">{site.intro}</p>
			<dl class="meta mono">
				<div><dt>Based</dt><dd>{site.location}</dd></div>
				<div><dt>Local</dt><dd data-clock>--:--:--</dd></div>
				<div><dt>Projects</dt><dd>{String(projects.length).padStart(2, '0')}</dd></div>
			</dl>
		</footer>
	</main>
</PortfolioLayout>

<script>
	import { initCursorTrail } from '../scripts/portfolio/cursor-trail';

	let timer = 0;
	document.addEventListener('astro:page-load', () => {
		initCursorTrail();
		clearInterval(timer);
		const clock = document.querySelector<HTMLElement>('[data-clock]');
		if (!clock) return;
		const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', second: '2-digit', timeZone: 'Asia/Seoul' });
		const tick = () => (clock.textContent = `${fmt.format(new Date())} KST`);
		tick();
		timer = window.setInterval(tick, 1000);
	});
</script>

<style>
	.home {
		height: 100dvh;
		display: grid;
		grid-template-rows: auto 1fr auto;
		padding: calc(var(--pad) * 0.75) var(--pad) var(--pad);
		position: relative;
		z-index: 1;
	}
	.top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: calc(var(--nav-h) - var(--pad) * 0.75);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--mono);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.dot {
		width: 0.55rem;
		height: 0.55rem;
		background: var(--accent);
		border-radius: 2px;
		transform: rotate(45deg);
	}
	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--fg-2);
		text-transform: none;
	}
	.pulse {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 0 0 #4ade8088;
		animation: pulse 2s infinite;
	}
	@keyframes pulse {
		70% {
			box-shadow: 0 0 0 7px #4ade8000;
		}
		100% {
			box-shadow: 0 0 0 0 #4ade8000;
		}
	}

	.menu {
		align-self: center;
		display: grid;
		gap: clamp(1rem, 3vh, 2rem);
	}
	.kicker {
		margin: 0;
		color: var(--fg-2);
		text-transform: none;
	}

	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: end;
		gap: 2rem;
		border-top: 1px solid var(--line);
		padding-top: 1.25rem;
	}
	.intro {
		margin: 0;
		max-width: 34rem;
		color: var(--fg-2);
		font-size: 0.9375rem;
		line-height: 1.7;
	}
	.meta {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
		margin: 0;
	}
	.meta dt {
		color: var(--fg-3);
		margin-bottom: 0.3rem;
	}
	.meta dd {
		margin: 0;
		color: var(--fg);
		font-variant-numeric: tabular-nums;
	}

	@media (max-width: 720px) {
		.bottom {
			flex-direction: column;
			align-items: start;
		}
		.intro {
			font-size: 0.875rem;
		}
	}

	/* cursor-trail objects (layer lives in the layout, styled here for the landing page) */
	:global(#trail-layer) {
		position: fixed;
		inset: 0;
		pointer-events: none;
		z-index: 0;
		overflow: hidden;
	}
	:global(.trail-obj) {
		position: absolute;
		left: 0;
		top: 0;
		transform: translate3d(var(--x), var(--y), 0) translate(-50%, -50%) rotate(var(--r)) scale(0.6);
		opacity: 0;
		transition:
			transform 360ms var(--ease-out),
			opacity 200ms var(--ease);
		will-change: transform, opacity;
	}
	:global(.trail-obj.in) {
		transform: translate3d(var(--x), var(--y), 0) translate(-50%, -50%) rotate(var(--r)) scale(1);
		opacity: 1;
	}
	:global(.trail-obj.out) {
		transform: translate3d(var(--x), var(--y), 0) translate(-50%, -50%) rotate(var(--r)) scale(0.85);
		opacity: 0;
		transition-duration: 420ms, 420ms;
	}
	:global(.trail-obj.is-img img) {
		width: clamp(9rem, 16vw, 15rem);
		aspect-ratio: 16 / 10;
		object-fit: cover;
		border-radius: 6px;
		box-shadow: 0 20px 40px -12px #000c;
	}
	:global(.trail-obj.is-text) {
		font-family: var(--mono);
		font-size: 0.875rem;
		padding: 0.45rem 0.75rem;
		border-radius: 6px;
		background: var(--bg-3);
		border: 1px solid var(--line-2);
		color: var(--accent);
		white-space: nowrap;
		box-shadow: 0 12px 30px -10px #000c;
	}
</style>
